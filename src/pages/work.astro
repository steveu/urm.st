---
import Base from '../layouts/Base.astro';
import EddyCasebook from '../components/eddy/EddyCasebook.astro';
import OneThoughtCasebook from '../components/onethought/OneThoughtCasebook.astro';
---

<Base title="Work" description="Eddy, a family video app, and One Thought, a golf app, told through the decisions behind them.">
  <h1 class="visually-hidden">Work</h1>
  <section id="eddy" aria-labelledby="eddy-title"><EddyCasebook /></section>
  <section id="one-thought" aria-labelledby="one-thought-title"><OneThoughtCasebook /></section>
</Base>

<style>
  section[id] {
    scroll-margin-top: 24px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import EddyCasebook from '../components/eddy/EddyCasebook.astro';

const sections = [{ id: 'eddy', label: 'Eddy' }]; // One Thought and Earlier work join later
---

<Base title="Work" description="Eddy, a family video app, told through the decisions behind it.">
  <div class="wrap work">
    <header class="intro">
      <h1>Work</h1>
      <p class="lede">A product I’m building, told through the decisions behind it.</p>
      {
        sections.length > 1 && (
          <nav aria-label="On this page">
            <ul>
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>
  </div>
  <section id="eddy" aria-labelledby="eddy-title"><EddyCasebook /></section>
</Base>

<style>
  .work {
    padding-block: clamp(64px, 10vw, 112px) clamp(48px, 6vw, 72px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .lede {
    max-width: 640px;
    font-size: 18px;
    color: var(--muted);
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 20px;
  }

  section[id] {
    scroll-margin-top: 24px;
  }
</style>

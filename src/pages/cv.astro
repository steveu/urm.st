---
import Base from '../layouts/Base.astro';
import { work, education, projects, skills } from '../data/cv';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const month = (ym: string) => `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`;

// One entry per role, newest first, so the date column reads as a single timeline
const roles = work.flatMap((job) => job.roles.map((role) => ({ ...role, company: job.company })));

// Splits a highlight on [text](url) into plain text and links
const parts = (h: string): { text: string; href?: string }[] =>
  h.split(/\[([^\]]+)\]\(([^)]+)\)/).flatMap((s, i, all) =>
    i % 3 === 0 ? (s ? [{ text: s }] : []) : i % 3 === 1 ? [{ text: s, href: all[i + 1] }] : [],
  );
---

<Base title="CV" description="CV for Steve Urmston, product engineer in York, UK: design, frontend engineering and product management since 2003.">
  <div class="ground">
    <article class="sheet">
      <header class="top">
        <div>
          <h1>Steve Urmston</h1>
          <p class="label">Product Engineer · York, UK</p>
        </div>
        <p class="contact">
          <a href="mailto:steve@urm.st">steve@urm.st</a>
          <a class="paper-only" href="https://urm.st">urm.st</a>
          <a href="https://www.linkedin.com/in/steveurmston/"><span class="screen">LinkedIn</span><span class="paper">linkedin.com/in/steveurmston</span></a>
          <a class="save" href="/steven-urmston-cv.pdf">Download PDF</a>
        </p>
      </header>

      <section class="profile" aria-labelledby="profile">
        <div>
          <h2 id="profile">Profile</h2>
          <p class="lede">
            I’ve worked as a designer, a frontend engineer and a product manager, often all at once. Now I design and build
            AI products, from the experience to the evals.
          </p>
        </div>
        <img src="/assets/images/avatar.jpg" alt="" width="104" height="104" />
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        <ol class="timeline">
          {
            roles.map((role) => (
              <li class:list={{ current: !role.end }}>
                <div class="what">
                  <h3>
                    {role.title}{role.company && `, ${role.company}`}
                  </h3>
                  <ul>
                    {role.highlights.map((h) => (
                      <li>{parts(h).map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</li>
                    ))}
                  </ul>
                </div>
                <p class="when">
                  <span class="end">{role.end ? month(role.end) : 'Now'}</span>
                  <span class="start">{month(role.start)}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="projects" aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        <ul>
          {
            projects.map((p) => (
              <li>
                <img src={p.icon} alt="" width="44" height="44" />
                <div>
                  <h3>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h3>
                  <p>{p.summary}</p>
                  {p.tech && <p class="tech">{p.tech}</p>}
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="education" aria-labelledby="education">
        <h2 id="education">Education</h2>
        <ol>
          {
            education.map((e) => (
              <li>
                <div class="row">
                  <h3>
                    {e.award}, {e.institution}
                  </h3>
                  <p class="years">{e.end ? `${e.start} – ${e.end}` : e.start}</p>
                </div>
                {e.highlights && (
                  <ul>
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section class="skills" aria-labelledby="skills">
        <h2 id="skills">Skills</h2>
        <p>{skills.join(' · ')}</p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* The page is a printed sheet on a grey ground, as the PDF would be */
  .ground {
    --ground: #ebe8e2;
    --rail: #d6d0c5;
    background: var(--ground);
    padding: clamp(24px, 4vw, 48px) 16px clamp(64px, 8vw, 120px);
  }

  .sheet {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 920px;
    margin-inline: auto;
    padding: clamp(32px, 5vw, 56px) clamp(24px, 6vw, 64px) clamp(40px, 6vw, 72px);
    background: var(--panel);
    border-top: 6px solid var(--text);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.05),
      0 16px 48px rgb(0 0 0 / 0.07);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(30px, 4vw, 36px);
    font-weight: 400;
    line-height: 1.15;
  }

  .label {
    margin: 6px 0 0;
    font-size: 18px;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
  }

  .contact a,
  .save {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    color: var(--text);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--accent);
  }

  /* On paper the addresses have to be readable, not just clickable; the site's own address only matters there */
  .paper,
  .contact .paper-only {
    display: none;
  }

  .contact .save {
    font-weight: 700;
    color: var(--accent);
  }

  .contact .save:hover {
    color: var(--accent-hover);
  }

  h2 {
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .profile > div {
    flex: 999 1 420px;
  }

  .lede {
    margin: 0;
    font-size: clamp(17px, 1.6vw, 18px);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .profile img {
    flex: 0 0 auto;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 6px var(--surface);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.35;
  }

  .sheet ul {
    margin: 6px 0 0;
    list-style: disc;
    padding-left: 20px;
    color: #3a3733;
    line-height: 1.55;
  }

  .sheet ul li + li {
    margin-top: 4px;
  }

  /* A quiet link to the work itself: reads as text until it's hovered */
  .what li a {
    color: inherit;
    text-decoration: underline dotted var(--faint);
    text-underline-offset: 3px;
  }

  .what li a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  /* Experience: the detail on the left, the dates on the right carrying one line, a dot per role */
  .timeline > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 156px;
    column-gap: 32px;
  }

  .what {
    padding-bottom: 26px;
  }

  .when {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 3px 30px 0 0;
    text-align: right;
    font-size: 14px;
  }

  .end {
    color: #3a3733;
  }

  .start {
    color: var(--faint);
  }

  .when::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 6.5px;
    width: 1px;
    background: var(--rail);
  }

  .timeline > li:first-child .when::before {
    top: 12px;
  }

  .timeline > li:last-child .when::before {
    bottom: calc(100% - 12px);
  }

  .when::after {
    content: '';
    position: absolute;
    top: 7px;
    right: 1px;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border: 2px solid var(--orange);
    border-radius: 50%;
    background: var(--panel);
  }

  .current .when::after {
    background: var(--orange);
  }

  /* Projects: each app's own icon beside its name, linked to its section on /work */
  .projects {
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .projects ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: inherit;
  }

  .projects li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .projects ul li + li {
    margin-top: 0;
  }

  .projects img {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }

  .projects h3 a {
    color: var(--text);
    text-decoration: underline dotted var(--faint);
    text-underline-offset: 4px;
  }

  .projects h3 a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .projects p {
    margin: 4px 0 0;
    color: #3a3733;
    line-height: 1.55;
  }

  .projects .tech {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .education {
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .education ol {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 24px;
  }

  .row h3 {
    font-size: 18px;
  }

  .years {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .skills {
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .skills p {
    margin: 0;
    color: #3a3733;
    line-height: 1.6;
  }

  /* Phones: dates go above each role on one line, and the rail steps aside */
  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: minmax(0, 1fr);
    }

    .when {
      order: -1;
      flex-direction: row-reverse;
      justify-content: flex-end;
      gap: 0.4em;
      padding: 0 0 4px;
      text-align: left;
      font-size: 13px;
    }

    .end::before {
      content: '– ';
    }

    .when::before,
    .when::after {
      display: none;
    }

    .contact {
      align-items: flex-start;
    }
  }

  /* Print: two A4 pages, set like a document. No photo, as UK CVs usually go without */
  @page {
    size: A4;
    margin: 18mm 20mm;
  }

  @media print {
    :global(html) {
      font-size: 9.5pt;
    }

    :global(body) {
      border-top: 0;
      background: none;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .contact .save,
    .screen,
    .profile img {
      display: none;
    }

    .paper {
      display: inline;
    }

    .contact .paper-only {
      display: inline-flex;
    }

    .ground {
      padding: 0;
      background: none;
    }

    .sheet {
      gap: 14px;
      max-width: none;
      padding: 0;
      box-shadow: none;
      border-top: 0;
      font-size: 9.5pt;
    }

    .top {
      padding-bottom: 12px;
    }

    h1 {
      font-size: 20pt;
    }

    .label,
    .contact {
      font-size: 10pt;
    }

    .contact a {
      min-height: 0;
    }

    h2 {
      margin-bottom: 8px;
      font-size: 8.5pt;
    }

    h3,
    .row h3 {
      font-size: 10.5pt;
    }

    .profile,
    .education,
    .projects,
    .skills {
      padding-top: 12px;
      padding-bottom: 0;
    }

    .profile {
      border-bottom: 0;
    }

    .lede {
      font-size: 10pt;
      line-height: 1.5;
    }

    .sheet ul {
      margin-top: 4px;
      line-height: 1.5;
    }

    .sheet ul li + li {
      margin-top: 3px;
    }

    .timeline > li {
      grid-template-columns: minmax(0, 1fr) 96px;
      column-gap: 28px;
    }

    .what {
      padding-bottom: 16px;
    }

    .when {
      padding-top: 1px;
      font-size: 8.5pt;
    }

    .projects ul {
      gap: 10px 28px;
    }

    .projects img {
      width: 28px;
      height: 28px;
      border-radius: 6px;
    }

    .projects p,
    .skills p {
      line-height: 1.4;
    }

    .education ol {
      gap: 6px;
    }

    .years {
      font-size: 8.5pt;
    }

    .timeline > li,
    .projects li,
    .education li {
      break-inside: avoid;
    }

    h2 {
      break-after: avoid;
    }
  }
</style>

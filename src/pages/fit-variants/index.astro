---
// Index of the fit check band's mock-ups. Throwaway: not for merging.
import Base from '../../layouts/Base.astro';

const current = [
  {
    href: '/#fit-check',
    name: 'The band now',
    line: 'Live: opens on a real role picked from public job boards and checked by Haiku. Needs the preview server for the check itself.',
  },
  {
    href: '/fit-variants/jev-aligned',
    name: 'Jev checks Haiku',
    line: 'Latest Jev experiment, static: Jev reads every sentence first, then Haiku’s verdict arrives with Jev’s agreement on each reason.',
  },
];

const earlier = [
  { href: '/fit-variants/jev', name: 'Jev first', line: 'Jev’s criteria decide the verdict. Dropped: two verdicts on one page.' },
  { href: '/fit-variants/real-role/live', name: 'Real role by default', line: 'Static states of what is now the live band.' },
  { href: '/fit-variants/real-role/tile', name: 'Real-role tile', line: 'The first try at a real role, not the default.' },
  { href: '/fit-variants/real-role/strip', name: 'Ask strip', line: 'Kinds of role and a button. Not chosen.' },
  { href: '/fit-variants/real-role/list', name: 'Live list', line: 'Five live roles to pick from. Not chosen: reads like a shortlist.' },
];
---

<Base title="Fit check mock-ups" noindex>
  <section class="wrap idx">
    <h1>Fit check mock-ups</h1>
    <p class="sub">Look at these two.</p>
    <ol class="current">
      {
        current.map((v, i) => (
          <li>
            <a href={v.href}>
              <span class="n">{i + 1}</span>
              <span class="name">{v.name}</span>
              <span class="line">{v.line}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <details>
      <summary>Earlier rounds, kept for the record</summary>
      <ul>
        {
          earlier.map((v) => (
            <li>
              <a href={v.href}>
                <span class="n">·</span>
                <span class="name">{v.name}</span>
                <span class="line">{v.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </section>
</Base>

<style>
  .idx {
    padding-block: 64px;
  }
  h1 {
    font-size: 1.75rem;
  }
  .sub {
    margin-top: 8px;
    color: var(--muted, #6b665e);
  }
  ol,
  ul {
    margin-top: 24px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }
  a {
    display: grid;
    grid-template-columns: 32px 200px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid #e8e4dc;
    color: inherit;
    text-decoration: none;
  }
  a:hover .name {
    text-decoration: underline;
  }
  .current .name {
    font-size: 1.125rem;
  }
  .n {
    font-family: var(--font-mono);
    color: #8a8a86;
  }
  .name {
    font-weight: 700;
  }
  details {
    margin-top: 48px;
    color: var(--muted, #6b665e);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>

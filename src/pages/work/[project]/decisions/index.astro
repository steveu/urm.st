---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { projects } from '../../../../data/projects';
import { projectInfo, formatDate, byDecided, type ProjectKey } from '../../../../data/projectNames';

export async function getStaticPaths() {
  const all = await getCollection('decisions');
  const projects = [...new Set(all.map((d) => d.data.project))];
  return projects.map((project) => ({ params: { project } }));
}

const project = Astro.params.project as ProjectKey;
const info = projectInfo[project];
const decisions = (await getCollection('decisions', (d) => d.data.project === project)).sort(byDecided);
const retroCount = decisions.filter((d) => d.data.retroactive).length;
const commitsByMonth: Record<string, number> = projects.find((p) => p.key === project)?.activity?.months ?? {};
const first = decisions[0]?.data.date;
const last = decisions.at(-1)?.data.date;

// One entry per calendar month, from the first sign of activity to the last,
// so quiet months stay visible rather than being skipped.
const monthKey = (d: Date) => d.toISOString().slice(0, 7);
const keys = [...decisions.map((d) => monthKey(d.data.date)), ...Object.keys(commitsByMonth)].sort();
const months: { key: string; label: string; commits: number; items: typeof decisions }[] = [];
if (keys.length) {
  const [y0, m0] = keys[0].split('-').map(Number);
  const [y1, m1] = keys.at(-1)!.split('-').map(Number);
  for (let y = y0, m = m0; y < y1 || (y === y1 && m <= m1); m === 12 ? ((m = 1), y++) : m++) {
    const key = `${y}-${String(m).padStart(2, '0')}`;
    months.push({
      key,
      label: new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      commits: commitsByMonth[key] ?? 0,
      items: decisions.filter((d) => monthKey(d.data.date) === key),
    });
  }
}
const plural = (n: number, word: string) => `${n === 0 ? 'No' : n} ${word}${n === 1 ? '' : 's'}`;
const dayMonth = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<Base title={`${info.name} decisions`} description={`The ${decisions.length} decisions behind ${info.name}, month by month.`}>
  <article class="wrap page" style={`--swatch: ${info.swatch}; --ink: ${info.ink}`}>
    <header class="intro">
      <p class="crumbs"><a href="/work">Work</a> <span aria-hidden="true">/</span> {info.name}</p>
      <h1>How {info.name} was decided</h1>
      <p class="lede">
        {decisions.length} decisions, month by month{first && last && <>, from {formatDate(first)} to {formatDate(last)}</>}.
        Each is a written record of what was chosen and why, and the agents building {info.name} read them before touching
        the code.
        {retroCount > 0 && <> {retroCount} were written up afterwards, reconstructed from the plan, design notes and commit history.</>}
      </p>
      <p class="edit-note">
        Lightly edited for publication: personal details, places, private hostnames and internal references are removed.
        The reasoning is unchanged.
      </p>
    </header>

    <div class="journal">
      {
        months.map((m) => (
          <section class:list={['month', { quiet: m.items.length === 0 }]} aria-labelledby={`m-${m.key}`}>
            <header class="month-head">
              <h2 id={`m-${m.key}`}>{m.label}</h2>
              <p class="tally">
                {plural(m.items.length, 'decision')} · {plural(m.commits, 'commit')}
              </p>
            </header>
            {m.items.length > 0 ? (
              <ol class="entries">
                {m.items.map((d) => (
                  <li>
                    <div class="entry">
                      <span class="day">{dayMonth(d.data.date)}</span>
                      <span class="title">{d.data.title}</span>
                      <span class="summary">{d.data.summary}</span>
                      {(d.data.retroactive || d.data.amended) && (
                        <span class="tags">
                          {d.data.retroactive && <span class="tag">written up afterwards</span>}
                          {d.data.amended && <span class="tag amended">amended</span>}
                        </span>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="entries empty" aria-hidden="true" />
            )}
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .page {
    padding-block: clamp(56px, 8vw, 96px) 0;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--faint);
  }

  .crumbs span {
    margin-inline: 6px;
  }

  h1 {
    font-size: clamp(32px, 4.4vw, 50px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lede {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .edit-note {
    font-size: 14px;
    line-height: 1.5;
    color: var(--faint);
    padding-left: 14px;
    border-left: 3px solid var(--swatch);
  }

  /* Months: a sticky label on the left, decisions hanging off a rule on the right */
  .month {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 40px;
    border-top: 1px solid var(--line);
  }

  .month-head {
    position: sticky;
    top: 0;
    align-self: start;
    padding-block: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .month-head h2 {
    font-size: 19px;
  }

  .tally {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .quiet .month-head {
    padding-block: 14px;
  }

  .quiet h2 {
    font-size: 16px;
    color: var(--muted);
  }

  .entries {
    margin: 0;
    padding: 12px 0 12px 28px;
    list-style: none;
    border-left: 2px solid color-mix(in srgb, var(--swatch) 45%, transparent);
  }

  .entries.empty {
    padding: 0;
    min-height: 100%;
  }

  .entries li {
    position: relative;
  }

  /* The node on the rule */
  .entries li::before {
    content: '';
    position: absolute;
    left: -35px;
    top: 26px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .entry {
    display: grid;
    gap: 6px;
    padding-block: 18px;
  }

  .day {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
  }

  .title {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .summary {
    max-width: 680px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--surface);
    color: var(--muted);
  }

  .tag.amended {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .month {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .month-head {
      position: static;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-block: 18px 6px;
    }

    .quiet .month-head {
      padding-block: 12px;
    }

    .entries {
      margin-left: 6px;
      padding-left: 22px;
    }

    .entries.empty {
      display: none;
    }

    .entries li::before {
      left: -29px;
    }
  }
</style>

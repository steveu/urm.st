---
// Weekly commit bars from the activity snapshot (scripts/activity.mjs).
interface Props {
  weeks: number[];
  last?: string;
  asOf: string;
  colour: string;
}

const { weeks, last, asOf, colour } = Astro.props;
const W = 150;
const H = 24;
const gap = 2;
const bar = (W - gap * (weeks.length - 1)) / weeks.length;
const max = Math.max(...weeks, 1);
// Square-root scale so a 100-commit week doesn't flatten everything else
const h = (n: number) => (n === 0 ? 1 : Math.max(3, Math.sqrt(n / max) * H));
const total = weeks.reduce((a, b) => a + b, 0);
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const label = `${total} commits over the ${weeks.length} weeks to ${fmt(asOf)}${last ? `, most recently on ${fmt(last)}` : ''}`;
---

<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} style={`--bar: ${colour}`}>
  <title>{label}</title>
  {
    weeks.map((n, i) => (
      <rect x={i * (bar + gap)} y={H - h(n)} width={bar} height={h(n)} rx="1" class={n === 0 ? 'empty' : undefined} />
    ))
  }
</svg>

<style>
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  rect {
    fill: var(--bar);
  }

  rect.empty {
    fill: var(--line);
  }
</style>

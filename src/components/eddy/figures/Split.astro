---
// Decision 0015 · The guard judges safety; the family judges taste: its drawing on /work. Rules for these: src/components/figures/RULES.md
const ALT = 'The guard scored 51% clear-yes precision against a 95% target, because a parent’s Block meant two things. Block now splits into Unsafe, the only answer the guard is measured on, and Not for us, the family’s taste.';
---

<p class="visually-hidden">{ALT}</p>
<div class="fig" data-figure="eddy-split" aria-hidden="true">
  <div class="split">
    <div class="score">
      <p class="big">51%</p>
      <p class="cap">clear-yes precision</p>
    </div>
    <div class="rail">
      <span class="fill" />
      <span class="target"><span class="tag">target 95%</span></span>
    </div>
    <div class="fork">
      <span class="chip block">Block</span>
      <svg viewBox="0 0 32 64" aria-hidden="true">
        <path pathLength="1" d="M0 32 C16 32 16 10 32 10" />
        <path pathLength="1" d="M0 32 C16 32 16 54 32 54" />
      </svg>
      <div class="ends">
        <p class="end unsafe"><span class="chip">Unsafe</span><span class="note">the guard is measured on this</span></p>
        <p class="end taste"><span class="chip">Not for us</span><span class="note">the family’s taste</span></p>
      </div>
    </div>
  </div>
</div>

<style>
  .fig {
    width: 100%;
  }

  /* The three drawings share one hand: the band's teal for the system, gold for the line
     the decision draws, small sans labels, and each plays in once when it comes into view */
  .fig :is(.lbl, .note, .cap, .key) {
    font-size: 12px;
    line-height: 1.35;
    color: var(--faint);
  }

  /* 0015 · the split: the score short of its target, and why — one answer meant two, so the
     decision draws its line (gold) through Block, and only the Unsafe half is scored */
  .split {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
  }

  .score {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .big {
    font: 400 34px/1 var(--font-serif);
    color: var(--ink);
  }

  /* The measure: a hairline track, the score in the band's teal, the target a pale tick */
  .rail {
    position: relative;
    height: 6px;
    margin-top: 24px;
    border-radius: 3px;
    background: rgb(243 239 230 / 0.1);
  }

  .rail .fill {
    position: absolute;
    inset: 0 49% 0 0;
    border-radius: 3px;
    background: var(--ring);
    transform-origin: left;
  }

  .rail .target {
    position: absolute;
    left: 95%;
    top: -5px;
    width: 2px;
    height: 16px;
    margin-left: -1px;
    border-radius: 1px;
    background: rgb(243 239 230 / 0.55);
  }

  .target .tag {
    position: absolute;
    right: -1px;
    bottom: calc(100% + 4px);
    font: 11px/1 var(--font-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--faint);
  }

  /* The answer: Block forks along a gold line into the two things it meant */
  .fork {
    display: grid;
    grid-template-columns: auto 32px minmax(0, 1fr);
    align-items: center;
    margin-top: 22px;
  }

  .fork svg {
    display: block;
    width: 32px;
    height: 64px;
    overflow: visible;
  }

  .fork path {
    fill: none;
    stroke: var(--eddy-gold);
    stroke-width: 1.5;
    stroke-dasharray: 1 1.01;
  }

  .ends {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 64px;
    min-width: 0;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-block: -6px;
    min-width: 0;
  }

  .end .note {
    min-width: 0;
  }

  .chip {
    flex: none;
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;
  }

  .chip.block {
    background: rgb(243 239 230 / 0.12);
    color: var(--ink);
  }

  .unsafe .chip { background: var(--risk); color: #2a1a17; }
  .unsafe .note { color: var(--soft); }
  .taste .chip { box-shadow: inset 0 0 0 1px rgb(243 239 230 / 0.3); color: var(--soft); }

  /* Entrance, once in view (play.ts lifts [data-wait]). Held back at once: only the way in moves.
     The story in order: the score falls short of its target, Block arrives, the gold line
     splits it, and the two answers settle at its ends, Unsafe landing first */
  @media (prefers-reduced-motion: no-preference) {
    .fig[data-wait] :is(*, *::before, *::after) { transition: none !important; }

    /* The score and its target settle down into place, the numeral heavier and slower */
    .fig[data-wait] .score { opacity: 0; transform: translateY(4px); }
    .fig .score {
      transition:
        opacity calc(var(--fig-base) * 0.6) var(--ease-out),
        transform var(--fig-base) var(--fig-settle);
    }
    .fig[data-wait] .target { opacity: 0; transform: translateY(-6px); }
    .fig .target {
      transition:
        opacity var(--fig-fast) var(--ease-out),
        transform var(--fig-fast) var(--fig-settle);
      transition-delay: var(--fig-step);
    }

    /* The fill runs out along the rail and comes to rest well short of the tick */
    .fig[data-wait] .rail .fill { transform: scaleX(0); }
    .fig .rail .fill { transition: transform var(--fig-slow) var(--fig-settle) 100ms; }

    /* Block slides in along the flow, then the gold line draws out of it */
    .fig[data-wait] .chip.block { opacity: 0; transform: translateX(-6px); }
    .fig .chip.block {
      transition:
        opacity var(--fig-fast) var(--ease-out),
        transform var(--fig-base) var(--fig-settle);
      transition-delay: 380ms;
    }
    .fig[data-wait] .fork path { stroke-dashoffset: 1; }
    .fig .fork path { transition: stroke-dashoffset var(--fig-fast) var(--fig-settle) 540ms; }

    /* Each answer arrives at the end of its branch as the line reaches it; Unsafe is the
       one that lands, with the spring's small overshoot */
    .fig[data-wait] .end { opacity: 0; transform: translateX(-10px); }
    .fig .end {
      transition:
        opacity calc(var(--fig-base) * 0.6) var(--ease-out),
        transform var(--fig-base) var(--fig-settle);
      transition-delay: calc(700ms + var(--fig-step));
    }
    .fig .end.unsafe {
      transition-timing-function: var(--ease-out), var(--fig-spring);
      transition-delay: 700ms;
    }
  }
</style>

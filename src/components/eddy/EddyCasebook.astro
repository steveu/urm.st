---
// Eddy on /work: told through three of its decisions, each with a small diagram.
// One band in the home band's palette holds the whole chapter: Eddy's app in the rings,
// then the decisions on panels of the same teal.
import { getCollection } from 'astro:content';
import { formatDate } from '../../data/projectNames';
import EddyApp from './EddyApp.astro';
import Home from './figures/Home.astro';
import Split from './figures/Split.astro';
import Slate from './figures/Slate.astro';

const FEATURED = [4, 15, 9];
const all = await getCollection('decisions', (d) => d.data.project === 'eddy');
const featured = FEATURED.map((n) => all.find((d) => d.data.number === n)!);

---

<div class="casebook">
  <div class="band">
    <header class="head wrap">
      <div class="text">
        <p class="eyebrow">
          <img src="/icons/eddy.png" width="32" height="32" alt="" /> <span>Eddy</span><span class="status"
            ><span class="dot"></span>In daily family use since April</span
          >
        </p>
        <h2 id="eddy-title">A family video app with a feed that&nbsp;ends.</h2>
        <div class="lede">
          <p>
            Kids share a link from anywhere. A model running locally at home checks it against their age, and it comes back
            in a feed that ends. There’s no chat, no endless scroll, and nothing about what they watch leaves the house.
          </p>
          <p class="mine">I designed and built all of it: the product, the app, the guard, and the rubric and evals that keep it honest.</p>
          <p class="tech">Gemma 4 · Ollama · Node · SQLite · iOS</p>
          <p class="links">
            <a href="https://github.com/eddy-hq/eddy">Source on GitHub <span aria-hidden="true">↗</span></a>
          </p>
        </div>
      </div>
      <!-- The Eddy site's hero art: rings around the app itself -->
      <div class="art">
        <span class="b1"></span>
        <span class="b2"></span>
        <span class="b3"></span>
        <div class="phone"><EddyApp /></div>
      </div>
    </header>

    <div class="wrap body">
    <div class="cases-head">
      <p>Three decisions</p>
      <a href="/work/eddy/decisions">All {all.length} decisions <span aria-hidden="true">→</span></a>
    </div>
    <ol class="cases">
      {
        featured.map((d) => (
          <li>
            <article class="case">
              <div class="case-text">
                <p class="when">{formatDate(d.data.date)}</p>
                <h3>{d.data.title}</h3>
                <p class="summary">{d.data.summary}</p>
              </div>
              <div class="figure">
                {d.data.number === 4 && <Home />}
                {d.data.number === 15 && <Split />}
                {d.data.number === 9 && <Slate />}
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    </div>
  </div>
</div>

<style>
    /* The home band's palette, held still, for the whole chapter */
  .band {
    --ink: #f3efe6;
    --soft: #c9d6d2;
    --faint: #9db0ac;
    --ring: #4e9ca0;
    --hair: rgb(243 239 230 / 0.16);
    --risk: #d4786d;
    position: relative;
    overflow: hidden;
    padding-block: clamp(32px, 3.5vw, 48px) clamp(48px, 5vw, 72px);
    background: var(--eddy-deep);
    color: var(--ink);
  }

  .band :focus-visible {
    outline-color: var(--eddy-gold);
  }

  .head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 56px;
    align-items: center;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--eddy-gold);
  }

  .eyebrow img {
    border-radius: 7px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 8px;
    font-weight: 400;
    letter-spacing: 0;
    color: #c9d6d2;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7fd1a3;
    box-shadow: 0 0 0 3px rgb(127 209 163 / 0.2);
  }

  h2 {
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 17px;
    line-height: 1.65;
    color: #c9d6d2;
    text-wrap: pretty;
  }

  .mine {
    color: #f3efe6;
  }

  .tech {
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid rgb(243 239 230 / 0.16);
    font: 12.5px var(--font-mono);
    color: #9db0ac;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 15px;
    font-weight: 700;
  }

  .links a {
    color: var(--eddy-gold);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The Eddy site's hero art: three squircle rings centred on the phone, which stands
     taller than them. Every length a multiple of --u, a 600th of the art's width. */
  /* Sized from the phone, as the Eddy site has it: the outer ring twice the phone's width */
  .art {
    --u: calc(100cqw / 600);
    container-type: inline-size;
    position: relative;
    width: 596px;
    justify-self: end;
    aspect-ratio: 600 / 720;
  }

  .art > span {
    position: absolute;
    background: #4e9ca0;
  }

  .b1 { inset: calc(60 * var(--u)) 0; border-radius: calc(176 * var(--u)); opacity: 0.12; }
  .b2 { inset: calc(120 * var(--u)) calc(60 * var(--u)); border-radius: calc(140 * var(--u)); opacity: 0.22; }
  .b3 { inset: calc(180 * var(--u)) calc(120 * var(--u)); border-radius: calc(106 * var(--u)); opacity: 0.5; }

  .phone {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .body {
    width: 100%;
    margin-top: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cases-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
    font-size: 14px;
    font-weight: 700;
  }

  .cases-head p {
    letter-spacing: 0.04em;
    color: var(--eddy-gold);
  }

  .cases-head a {
    color: var(--eddy-gold);
    text-decoration: none;
  }

  .cases-head a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The three decisions */
  .cases {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px clamp(24px, 3vw, 40px);
  }

  /* Diagram first, then what it shows; subgrid lines the wells and text up across columns */
  .cases > li,
  .case {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 20px;
  }

  .case .figure {
    order: -1;
  }

  .case-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .when {
    font: 13px var(--font-mono);
    color: var(--faint);
  }

  h3 {
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.25;
    text-wrap: balance;
  }

  .summary {
    font-size: 14px;
    line-height: 1.6;
    color: var(--soft);
    text-wrap: pretty;
  }

  /* The drawing sits on the band itself, no well round it, lined up with the words under it */
  .figure {
    min-height: 168px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    color: var(--ring);
  }

  /* Narrower: the art and the phone come down together, holding the proportion */
  @media (max-width: 1180px) {
    .art { width: 480px; }
    .phone { transform: translate(-50%, -50%) scale(0.805); }
  }

  @media (max-width: 960px) {
    .head { grid-template-columns: minmax(0, 1fr); }
    .phone { transform: translate(-50%, -50%); }
    /* Under the text, the art shrinks with the screen but the phone doesn't: leave room
       for it to stand out of the rings (half its 625px height less half the art's) */
    .art { width: 100%; max-width: 520px; justify-self: center; margin-block: max(0px, calc(337px - 60vw)); }
  }

  @media (max-width: 960px) {
    .cases { grid-template-columns: minmax(0, 1fr); max-width: 560px; }
  }

  @media (max-width: 520px) {
    .eyebrow { flex-wrap: wrap; }
    .status { margin-left: 0; flex-basis: 100%; }
    .figure { min-height: 0; }
  }
</style>

<script>
  import '../figures/play';
</script>

---
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const decisions = await getCollection('decisions');
const decisionsFor = (key: string) => decisions.filter((d) => d.data.project === key);
const lastDecided = (key: string) => {
  const dates = decisionsFor(key).map((d) => d.data.date.getTime());
  return dates.length ? new Date(Math.max(...dates)) : undefined;
};
const shortDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="visually-hidden">Current projects</h2>
  <ul>
    {
      projects.map((p) => (
        <li class:list={['row', { muted: p.state === 'soon', linked: !!p.href }]}>
          <div class="about">
            <h3>
              {p.icon ? (
                <img class="icon" src={p.icon} width="32" height="32" alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="icon placeholder" aria-hidden="true" />
              )}
              {p.href ? <a href={p.href}>{p.name}</a> : p.name}
            </h3>
            <p class="desc">{p.description}</p>
          </div>
          <p class="status">
            <span class:list={['dot', p.state]} aria-hidden="true" />
            {p.status}
          </p>
          <div class="more">
            {decisionsFor(p.key).length > 0 && (
              <>
                <a class="decisions" href={`/work/${p.key}/decisions`}>
                  {decisionsFor(p.key).length} decisions →
                </a>
                <span class="last">last decided {shortDate(lastDecided(p.key)!)}</span>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px 150px;
    gap: 28px;
    align-items: center;
  }

  .row {
    position: relative;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s ease;
  }

  .row.linked:hover {
    background: var(--panel);
  }

  .about {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  h3 {
    flex: 0 0 180px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Whole-row link: the anchor stretches over its row */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row.linked:hover h3 a {
    color: var(--accent);
  }

  /* iOS-style tile: corner radius ≈ 22% of the side */
  .icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .icon.placeholder {
    box-shadow: none;
    border: 1px dashed var(--faint);
  }

  .desc {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot.live { background: var(--live); }
  .dot.beta { background: var(--orange); }
  .dot.soon { border: 1px solid var(--faint); }

  .muted h3,
  .muted .status {
    color: var(--muted);
  }

  .more {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .last {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  /* Sits above the row's stretched link */
  .decisions {
    position: relative;
    z-index: 1;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .decisions:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .about {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    h3 {
      flex-basis: auto;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'about status'
        'more more';
      gap: 12px 16px;
      padding: 16px 2px;
    }

    .about { grid-area: about; }
    .status { grid-area: status; align-self: start; padding-top: 3px; }
    .more { grid-area: more; flex-direction: row; align-items: baseline; justify-content: space-between; }
  }
</style>

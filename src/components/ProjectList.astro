---
import { projects, activityMeta } from '../data/projects';

// One shared month axis, from the first commit on any project to the snapshot, so the
// rows line up in time and a later start shows as empty months
const monthKey = (d: Date) => d.toISOString().slice(0, 7);
const firsts = projects.flatMap((p) => (p.activity?.first ? [p.activity.first] : [])).sort();
const axis: string[] = [];
if (firsts.length) {
  const end = monthKey(new Date(activityMeta.generatedAt));
  for (let d = new Date(firsts[0].slice(0, 7) + '-01'); monthKey(d) <= end; d.setUTCMonth(d.getUTCMonth() + 1)) {
    axis.push(monthKey(d));
  }
}
const peak = Math.max(1, ...projects.flatMap((p) => Object.values(p.activity?.months ?? {})));
// Square root, so a quiet month still shows beside a busy one
const barHeight = (n: number) => (n ? Math.max(2, Math.round(Math.sqrt(n / peak) * 28)) : 0);
const since = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
---

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="visually-hidden">Current projects</h2>
  <ul>
    {
      projects.map((p, row) => (
        <li class:list={['row', { muted: p.state === 'soon' }]} style={`--ink: ${p.ink}`}>
          <div class="who">
            {p.icon ? (
              <img class="icon" src={p.icon} width="32" height="32" alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="icon placeholder" aria-hidden="true" />
            )}
            <h3>{p.work ? <a href={p.work}>{p.name}</a> : p.name}</h3>
          </div>
          <p class="desc">{p.description}</p>
          <p class="status">
            <span class:list={['dot', p.state]} aria-hidden="true" />
            {p.status}
          </p>
          {p.activity ? (
            <div class="activity">
              <span class="bars" aria-hidden="true">
                {axis.map((m, i) => {
                  const n = p.activity!.months[m as keyof typeof p.activity.months] ?? 0;
                  return (
                    <span
                      class:list={['bar', { none: !n }]}
                      style={`--i: ${i}; --row: ${row};${n ? ` height: ${barHeight(n)}px` : ''}`}
                    />
                  );
                })}
              </span>
              <span class="count">
                {p.repo ? (
                  <a href={p.repo}>
                    {p.activity.total} commits <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <>{p.activity.total} commits</>
                )}{' '}
                since {since(p.activity.first)}
              </span>
            </div>
          ) : (
            <span class="activity" />
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  /* Who it is, what it is, how far along, and the work going into it */
  .row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 110px 172px;
    gap: 32px;
    align-items: center;
    min-height: 72px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h3 {
    font-size: 17px;
    line-height: 1.3;
  }

  /* The name is the way on to the project's section on /work */
  h3 a,
  .count a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover,
  .count a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* iOS-style tile: corner radius ≈ 22% of the side */
  .icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .icon.placeholder {
    box-shadow: none;
    border: 1px dashed var(--faint);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot.live { background: var(--live); }
  .dot.beta { background: var(--orange); }
  .dot.soon { border: 1px solid var(--faint); }

  .desc {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Commits per month: one bar a month on the shared axis, in the project's ink */
  .activity {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 28px;
  }

  .bar {
    width: 12px;
    border-radius: 1.5px 1.5px 0 0;
    background: var(--ink);
    opacity: 0.85;
    /* The months play in once, left to right and row by row, after the hero arrives */
    transform-origin: bottom;
    animation: bar-in 0.5s calc(0.5s + var(--row) * 0.12s + var(--i) * 0.05s) var(--ease-out) both;
  }

  .bar.none {
    height: 1px;
    background: var(--line);
    opacity: 1;
  }

  @keyframes bar-in {
    from { transform: scaleY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar { animation: none; }
  }

  .count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
  }

  .muted h3,
  .muted .status {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 160px minmax(0, 1fr) 100px 172px;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      padding: 14px 2px;
    }

    /* Under the name, not the icon */
    .desc,
    .activity {
      grid-column: 1 / -1;
      padding-left: 44px;
    }

    .activity:empty {
      display: none;
    }

    .status {
      grid-row: 1;
      grid-column: 2;
    }

    .activity {
      flex-direction: row;
      align-items: flex-end;
      gap: 12px;
    }
  }
</style>

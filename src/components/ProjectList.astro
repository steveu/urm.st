---
import { projects, activityMeta } from '../data/projects';

// One shared month axis, from the first commit on any project to the snapshot, so the
// rows line up in time and a later start shows as empty months
const monthKey = (d: Date) => d.toISOString().slice(0, 7);
const firsts = projects.flatMap((p) => (p.activity?.first ? [p.activity.first] : [])).sort();
const axis: string[] = [];
if (firsts.length) {
  const end = monthKey(new Date(activityMeta.generatedAt));
  for (let d = new Date(firsts[0].slice(0, 7) + '-01'); monthKey(d) <= end; d.setUTCMonth(d.getUTCMonth() + 1)) {
    axis.push(monthKey(d));
  }
}
const peak = Math.max(1, ...projects.flatMap((p) => Object.values(p.activity?.months ?? {})));
// Square root, so a quiet month still shows beside a busy one
const barHeight = (n: number) => (n ? Math.max(2, Math.round(Math.sqrt(n / peak) * 28)) : 0);
const since = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
---

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="visually-hidden">Current projects</h2>
  <ul>
    {
      projects.map((p) => (
        <li class:list={['row', { muted: p.state === 'soon' }]} style={`--ink: ${p.ink}`}>
          <div class="about">
            <h3>
              {p.icon ? (
                <img class="icon" src={p.icon} width="32" height="32" alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="icon placeholder" aria-hidden="true" />
              )}
              {p.name}
            </h3>
            <p class="desc">{p.description}</p>
          </div>
          <div class="activity">
            <span class="bars" aria-hidden="true">
              {axis.map((m) => {
                const n = p.activity?.months[m as keyof typeof p.activity.months] ?? 0;
                return <span class:list={['bar', { none: !n }]} style={n ? `height: ${barHeight(n)}px` : undefined} />;
              })}
            </span>
            {p.activity && (
              <span class="count">
                {p.activity.total} commits since {since(p.activity.first)}
              </span>
            )}
          </div>
          <p class="status">
            <span class:list={['dot', p.state]} aria-hidden="true" />
            {p.status}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px 120px;
    gap: 28px;
    align-items: center;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
  }

  .about {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  h3 {
    flex: 0 0 180px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
  }

  /* iOS-style tile: corner radius ≈ 22% of the side */
  .icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .icon.placeholder {
    box-shadow: none;
    border: 1px dashed var(--faint);
  }

  .desc {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    white-space: nowrap;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot.live { background: var(--live); }
  .dot.beta { background: var(--orange); }
  .dot.soon { border: 1px solid var(--faint); }

  /* Commits per month: one bar a month on the shared axis, in the project's ink */
  .activity {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 28px;
  }

  .bar {
    width: 12px;
    border-radius: 1.5px 1.5px 0 0;
    background: var(--ink);
    opacity: 0.85;
  }

  .bar.none {
    height: 1px;
    background: var(--line);
    opacity: 1;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
  }

  .muted h3,
  .muted .status {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .about {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    h3 {
      flex-basis: auto;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px 16px;
      padding: 16px 2px;
    }

    .activity { grid-row: 2; grid-column: 1 / -1; flex-direction: row; align-items: flex-end; gap: 12px; }
    .status { align-self: start; padding-top: 3px; }
  }
</style>

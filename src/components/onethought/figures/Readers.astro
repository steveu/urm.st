---
// Decision 0023 · Research claims are checked by two readers who never see each other: its drawing on /work. Rules for these: src/components/figures/RULES.md
// One claim goes to two readers, a neutral one and a sceptic, with a wall between them. The more
// cautious grade is the one kept, and a disagreement comes to me rather than being averaged
const ALT = 'Each research claim goes to two readers, one neutral and one sceptical, who never see each other. The more cautious grade stands; a disagreement is never averaged and comes to me.';
---

<p class="visually-hidden">{ALT}</p>
<div class="fig" data-figure="ot-readers" aria-hidden="true">
  <svg viewBox="0 0 300 200" class="draw">
    <g class="claim">
      <rect class="line page" x="14" y="54" width="34" height="44" rx="3" />
      <path class="thin" d="M21 65 H41 M21 72 H41 M21 79 H41 M21 86 H33" />
    </g>
    <path class="thin fork" pathLength="1" d="M48 76 C64 76 60 37 76 37" />
    <path class="thin fork" pathLength="1" d="M48 76 C64 76 60 115 76 115" />
    <g class="reader" style="--i: 0">
      <rect class="line" x="76" y="22" width="68" height="30" rx="5" />
      <text x="110" y="41" class="small">neutral</text>
    </g>
    <g class="reader" style="--i: 1">
      <rect class="line" x="76" y="100" width="68" height="30" rx="5" />
      <text x="110" y="119" class="small">sceptic</text>
    </g>
    <path class="wall" d="M70 76 H150" />
    <path class="thin join" pathLength="1" d="M144 37 C164 37 160 76 178 76" />
    <path class="thin join" pathLength="1" d="M144 115 C164 115 160 76 178 76" />
    <g class="land">
      <rect class="brassbox" x="178" y="60" width="108" height="32" rx="5" />
      <text x="232" y="80" class="small">the more cautious</text>
    </g>
    <g class="mid">
      <text x="110" y="152" class="name">two readers</text>
      <text x="110" y="168" class="note">never see each other</text>
    </g>
    <g class="late">
      <text x="232" y="152" class="name">never averaged</text>
      <text x="232" y="168" class="note">a disagreement comes to me</text>
    </g>
  </svg>
</div>
<style>
  .fig {
    width: 100%;
  }

  /* One drawing style for all three: ink line, one touch of brass, italic words */
  .draw {
    width: 100%;
    max-width: 300px;
    overflow: visible;
    font-family: 'Petrona Variable', Georgia, serif;
  }

  .draw .line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draw .thin {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-width: 1;
  }

  .draw .ink {
    fill: var(--ink);
  }

  .draw .faded {
    opacity: 0.6;
  }

  /* The parked penny is solid metal: a faint fill, against the Flic's white */
  .draw .faded > rect.line {
    fill: rgb(38 33 26 / 0.06);
  }

  .draw .window {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: 2 2;
  }

  .draw .flic {
    fill: #fffdf7;
    stroke: var(--ink);
    stroke-width: 1.6;
    filter: drop-shadow(0 6px 8px rgb(38 33 26 / 0.16));
  }

  .draw .ghost {
    fill: rgb(38 33 26 / 0.04);
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-dasharray: 3 3;
  }

  /* The claim and its source are paper: a faint fill */
  .draw .page {
    fill: rgb(38 33 26 / 0.06);
  }

  .draw .wall {
    stroke: var(--ink);
    stroke-opacity: 0.6;
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }

  .draw .brassdot,
  .draw .cell.lit {
    fill: var(--gold);
  }

  .draw .cell {
    fill: rgb(38 33 26 / 0.2);
  }

  .draw .brassbox {
    fill: rgb(201 162 74 / 0.3);
    stroke: var(--brass);
    stroke-width: 1.6;
  }

  .draw text {
    text-anchor: middle;
  }

  .draw text.left {
    text-anchor: start;
  }

  .draw .name {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }

  .draw .note {
    fill: var(--soft);
    font-size: 11.5px;
    font-style: italic;
  }

  .draw .note.brass {
    fill: var(--brass);
  }

  .draw .small {
    fill: var(--ink);
    font-size: 11px;
    font-style: italic;
  }

  .draw .clock {
    fill: var(--ink);
    font: 600 26px -apple-system, 'SF Pro Display', system-ui, sans-serif;
    text-anchor: middle;
  }

  /* Entrance, once in view (play.ts lifts [data-wait]). Held back at once: only the way in moves.
     The claim settles, the lines carry it to both readers, the wall slides in between them, and
     the answer drops onto its mark last (the one spring), its words following */
  @media (prefers-reduced-motion: no-preference) {
    .fig[data-wait] :is(*, *::before, *::after) { transition: none !important; }

    .fig[data-wait] .claim { opacity: 0; transform: translateY(-6px); }
    .fig .claim {
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--ease-out),
        transform var(--fig-fast) var(--fig-settle);
    }

    .fig :is(.fork, .join) { stroke-dasharray: 1; }
    .fig[data-wait] :is(.fork, .join) { stroke-dashoffset: 1; }
    .fig .fork { transition: stroke-dashoffset var(--fig-fast) 100ms var(--fig-settle); }
    .fig .join { transition: stroke-dashoffset var(--fig-fast) 600ms var(--fig-settle); }

    .fig[data-wait] .reader { opacity: 0; transform: translateX(-6px); }
    .fig .reader {
      --d: calc(300ms + var(--i) * var(--fig-step));
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }

    .fig .wall { transform-box: fill-box; transform-origin: left center; }
    .fig[data-wait] .wall { opacity: 0; transform: scaleX(0.94); }
    .fig .wall {
      transition:
        opacity calc(var(--fig-fast) * 0.6) 440ms var(--ease-out),
        transform var(--fig-fast) 440ms var(--fig-settle);
    }

    .fig .land { transform-box: fill-box; transform-origin: 50% 100%; }
    .fig[data-wait] .land { opacity: 0; transform: translateY(-6px) scale(0.96); }
    .fig .land {
      transition:
        opacity calc(var(--fig-base) * 0.6) 740ms var(--ease-out),
        transform var(--fig-base) 740ms var(--fig-spring);
    }

    .fig[data-wait] :is(.mid, .late) text { opacity: 0; transform: translateY(-4px); }
    .fig :is(.mid, .late) text {
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }
    .fig .mid text { --d: 520ms; }
    .fig .mid text + text { --d: calc(520ms + var(--fig-step)); }
    .fig .late text { --d: 880ms; }
    .fig .late text + text { --d: calc(880ms + var(--fig-step)); }
  }
</style>

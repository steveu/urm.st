---
// Decision 0016 · The app never calls you: its drawing on /work. Rules for these: src/components/figures/RULES.md
// A quiet lock screen: the slots where an app would call you stay empty
const ABSENT = ['no notifications', 'no streaks or badges', 'no dashboard, no feed'];
const ALT = 'A phone lock screen with nothing on it: no notifications, no streaks or badges, no dashboard or feed. The app waits to be opened after the round.';
---

<p class="visually-hidden">{ALT}</p>
<div class="fig" data-figure="ot-quiet" aria-hidden="true">
  <svg viewBox="0 0 300 200" class="draw">
    <g class="phone">
      <rect class="line body" x="14" y="18" width="84" height="150" rx="16" />
      <rect class="ink" x="44" y="25" width="24" height="6" rx="3" />
      <text x="56" y="56" class="clock">18:42</text>
      {ABSENT.map((_, i) => (
        <rect class="ghost slot" style={`--i: ${i}`} x="24" y={64 + i * 22} width="64" height="16" rx="5" />
      ))}
    </g>
    {ABSENT.map((label, i) => (
      <g class="absent" style={`--i: ${i}`}>
        <path class="thin lead" pathLength="1" d={`M94 ${72 + i * 22} H114`} />
        <text x="120" y={76 + i * 22} class="note left">{label}</text>
      </g>
    ))}
    <g class="late">
      <text x="120" y="152" class="name left">it waits to be opened</text>
      <text x="120" y="168" class="note brass left">we’ll be here after the round</text>
    </g>
  </svg>
</div>

<style>
  .fig {
    width: 100%;
  }

  /* One drawing style for all three: ink line, one touch of brass, italic words */
  .draw {
    width: 100%;
    max-width: 300px;
    overflow: visible;
    font-family: 'Petrona Variable', Georgia, serif;
  }

  .draw .line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draw .thin {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-width: 1;
  }

  .draw .ink {
    fill: var(--ink);
  }

  .draw .faded {
    opacity: 0.6;
  }

  /* The parked penny is solid metal: a faint fill, against the Flic's white */
  .draw .faded > rect.line {
    fill: rgb(38 33 26 / 0.06);
  }

  .draw .window {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: 2 2;
  }

  .draw .flic {
    fill: #fffdf7;
    stroke: var(--ink);
    stroke-width: 1.6;
    filter: drop-shadow(0 6px 8px rgb(38 33 26 / 0.16));
  }

  .draw .ghost {
    fill: rgb(38 33 26 / 0.04);
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-dasharray: 3 3;
  }

  .draw .wall {
    stroke: var(--ink);
    stroke-opacity: 0.6;
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }

  .draw .brassdot,
  .draw .cell.lit {
    fill: var(--gold);
  }

  .draw .cell {
    fill: rgb(38 33 26 / 0.2);
  }

  .draw .brassbox {
    fill: rgb(201 162 74 / 0.3);
    stroke: var(--brass);
    stroke-width: 1.6;
  }

  .draw text {
    text-anchor: middle;
  }

  .draw text.left {
    text-anchor: start;
  }

  .draw .name {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }

  .draw .note {
    fill: var(--soft);
    font-size: 11.5px;
    font-style: italic;
  }

  .draw .note.brass {
    fill: var(--brass);
  }

  .draw .small {
    fill: var(--ink);
    font-size: 11px;
    font-style: italic;
  }

  .draw .clock {
    fill: var(--ink);
    font: 600 26px -apple-system, 'SF Pro Display', system-ui, sans-serif;
    text-anchor: middle;
  }

  /* The phone is solid: a faint fill under its line */
  .draw .phone .body {
    fill: rgb(38 33 26 / 0.04);
  }

  .draw .clock {
    font-size: 22px;
  }

  /* Entrance, once in view (play.ts lifts [data-wait]). Held back at once: only the way in moves.
     The phone settles onto the table (the one thing that lands), then the empty slots show one by
     one down the screen, each label drawn out along its leader, then the answer */
  @media (prefers-reduced-motion: no-preference) {
    .fig[data-wait] :is(*, *::before, *::after) { transition: none !important; }

    .fig[data-wait] .phone { opacity: 0; transform: translateY(-8px); }
    .fig .phone {
      transition:
        opacity calc(var(--fig-base) * 0.6) var(--ease-out),
        transform var(--fig-base) var(--fig-spring);
    }

    .fig .slot { transform-box: fill-box; transform-origin: center; }
    .fig[data-wait] .slot { opacity: 0; transform: scale(0.96); }
    .fig .slot {
      --d: calc(300ms + var(--i) * var(--fig-step));
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }

    .fig .lead { stroke-dasharray: 1; }
    .fig[data-wait] .lead { stroke-dashoffset: 1; }
    .fig .lead { transition: stroke-dashoffset 300ms calc(360ms + var(--i) * var(--fig-step)) var(--fig-settle); }

    .fig[data-wait] .absent text { opacity: 0; transform: translateX(-6px); }
    .fig .absent text {
      --d: calc(420ms + var(--i) * var(--fig-step));
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }

    .fig[data-wait] .late text { opacity: 0; transform: translateY(-4px); }
    .fig .late text {
      --d: 800ms;
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }
    .fig .late text + text { --d: calc(800ms + var(--fig-step)); }
  }
</style>

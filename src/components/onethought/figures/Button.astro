---
// Decision 0019 · An off-the-shelf button, not a bespoke brass penny: its drawing on /work. Rules for these: src/components/figures/RULES.md
const ALT = 'The brass penny, a radio and battery sealed inside solid metal and about 80% of the cost, is parked. An off-the-shelf Flic button, certified and shipping, is the hardware.';
---

<p class="visually-hidden">{ALT}</p>
<div class="fig" data-figure="ot-button" aria-hidden="true">
  <svg viewBox="0 0 300 200" class="draw">
    <!-- The penny in section: a radio and a cell sealed in solid brass, with a window cut for the radio -->
    <g class="faded">
      <g class="rise" style="--d: 0ms">
        <rect class="line coin" x="18" y="70" width="110" height="36" rx="10" />
        <rect class="thin" x="30" y="78" width="86" height="20" rx="4" />
        <rect class="cell" x="38" y="82" width="28" height="12" rx="2" />
        <path class="thin" d="M74 91 H108" />
        <rect class="thin" x="84" y="85" width="14" height="6" rx="1" />
      </g>
      <g class="words">
        <text x="73" y="152" class="name" style="--d: 120ms">the penny, parked</text>
        <text x="73" y="168" class="note" style="--d: 190ms">radio and battery in brass</text>
        <text x="73" y="182" class="note" style="--d: 260ms">about 80% of the cost</text>
      </g>
    </g>
    <path class="line go" pathLength="1" d="M146 88 H172" />
    <path class="line head" d="M165 81 L172 88 L165 95" />
    <g class="pop">
      <rect class="flic" x="190" y="52" width="72" height="72" rx="22" />
      <rect class="thin" x="200" y="62" width="52" height="52" rx="16" />
    </g>
    <g class="words">
      <text x="226" y="152" class="name" style="--d: 760ms">a Flic, off the shelf</text>
      <text x="226" y="168" class="note brass" style="--d: 830ms">the hardware, not a stand-in</text>
    </g>
  </svg>
</div>

<style>
  .fig {
    width: 100%;
  }

  /* One drawing style for all three: ink line, one touch of brass, italic words */
  .draw {
    width: 100%;
    max-width: 300px;
    overflow: visible;
    font-family: 'Petrona Variable', Georgia, serif;
  }

  .draw .line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draw .thin {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-width: 1;
  }

  .draw .ink {
    fill: var(--ink);
  }

  .draw .faded {
    opacity: 0.6;
  }

  /* The parked penny is solid metal: a faint fill, against the Flic's white */
  .draw .faded > rect.line,
  .draw .coin {
    fill: rgb(38 33 26 / 0.06);
  }

  .draw .window {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-dasharray: 2 2;
  }

  .draw .flic {
    fill: #fffdf7;
    stroke: var(--ink);
    stroke-width: 1.6;
    filter: drop-shadow(0 6px 8px rgb(38 33 26 / 0.16));
  }

  .draw .ghost {
    fill: rgb(38 33 26 / 0.04);
    stroke: var(--ink);
    stroke-opacity: 0.4;
    stroke-dasharray: 3 3;
  }

  .draw .wall {
    stroke: var(--ink);
    stroke-opacity: 0.6;
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }

  .draw .brassdot,
  .draw .cell.lit {
    fill: var(--gold);
  }

  .draw .cell {
    fill: rgb(38 33 26 / 0.2);
  }

  .draw .brassbox {
    fill: rgb(201 162 74 / 0.3);
    stroke: var(--brass);
    stroke-width: 1.6;
  }

  .draw text {
    text-anchor: middle;
  }

  .draw text.left {
    text-anchor: start;
  }

  .draw .name {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }

  .draw .note {
    fill: var(--soft);
    font-size: 11.5px;
    font-style: italic;
  }

  .draw .note.brass {
    fill: var(--brass);
  }

  .draw .small {
    fill: var(--ink);
    font-size: 11px;
    font-style: italic;
  }

  .draw .clock {
    fill: var(--ink);
    font: 600 26px -apple-system, 'SF Pro Display', system-ui, sans-serif;
    text-anchor: middle;
  }

  /* Entrance, once in view (play.ts lifts [data-wait]). Held back at once: only the way in moves.
     The parked penny settles first, the arrow draws along the flow, the Flic lands (the one spring),
     and its words follow it */
  @media (prefers-reduced-motion: no-preference) {
    .fig[data-wait] :is(*, *::before, *::after) { transition: none !important; }

    .fig .rise {
      transition:
        opacity calc(var(--fig-base) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-base) var(--d) var(--fig-settle);
    }
    .fig[data-wait] .rise { opacity: 0; transform: translateY(-6px); }

    .fig[data-wait] .words text { opacity: 0; transform: translateY(-4px); }
    .fig .words text {
      transition:
        opacity calc(var(--fig-fast) * 0.6) var(--d) var(--ease-out),
        transform var(--fig-fast) var(--d) var(--fig-settle);
    }

    .fig .go { stroke-dasharray: 1; transition: stroke-dashoffset var(--fig-fast) 280ms var(--fig-settle); }
    .fig[data-wait] .go { stroke-dashoffset: 1; }
    .fig .head {
      transition:
        opacity calc(var(--fig-fast) * 0.6) 460ms var(--ease-out),
        transform var(--fig-fast) 460ms var(--fig-settle);
    }
    .fig[data-wait] .head { opacity: 0; transform: translateX(-4px); }

    .fig .pop {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      transition:
        opacity calc(var(--fig-base) * 0.6) 490ms var(--ease-out),
        transform var(--fig-base) 490ms var(--fig-spring);
    }
    .fig[data-wait] .pop { opacity: 0; transform: translateY(-6px) scale(0.96); }
  }
</style>

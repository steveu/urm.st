  /* The opening mark hangs, so the words line up with the copy above */
  .result :global(.quote p) { text-indent: -0.42em; }
  .result :global(.quote p::before) { content: '“'; color: var(--faint); }
  .result :global(.quote p::after) { content: '”'; color: var(--faint); }

  /* In the posting itself, a mark shows where each quote came from: a highlighter, low */
  .result :global(.ptext mark) {
    padding: 0 1px;

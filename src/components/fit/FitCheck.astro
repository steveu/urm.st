---
// Home band for job-radar's fit check: paste a job posting and see whether I'd fit it, with a
// quote from the posting behind every reason. Four made-up samples come first, answered ahead
// of time by the real check and committed (src/fit/sample-results.json), so they're instant,
// free, and switch with scripts off: they're radio buttons, and CSS shows the checked one.
// Every word in a result is site copy or the posting's own text; see ./result.ts.
import { LIMITS } from '../../fit/check';
import { VERDICT_COPY } from '../../fit/copy';
import { FIT_CHECK_PATH } from '../../fit/handler';
import { SAMPLE_POSTINGS } from '../../fit/samples';
import { SAMPLE_RESULTS } from '../../fit/sample-results';
import { EVAL_FIGURES } from '../../fit/evals/figures';
import { markedPostingHtml, resultHtml, VERDICT_LEVEL } from './result';

const START = 'strong';

const samples = SAMPLE_POSTINGS.map((s) => {
  const result = SAMPLE_RESULTS.results[s.id];
  if (!result) throw new Error(`No committed result for the ${s.id} sample: run scripts/fit-samples.ts`);
  const quotes = [...result.reasons.map((r) => r.quote), result.location.quote, result.injection.quote].filter((q): q is string => !!q);
  return { ...s, result, posting: markedPostingHtml(s.text, quotes) };
});

// The art: a posting on the radar, read and marked. Line widths in the art's own units
const LINES = [
  { w: 132, title: true },
  { w: 96 },
  { w: 176 },
  { w: 160, mark: 1 },
  { w: 184 },
  { w: 120 },
  { w: 172, mark: 2 },
  { w: 150 },
  { w: 180, mark: 3 },
  { w: 108 },
];
---

<section id="fit-check" class="band" aria-labelledby="fit-check-title" data-fit>
  <div class="wrap">
    <header class="head">
      <div class="text">
        <p class="eyebrow">job-radar</p>
        <h2 id="fit-check-title">Would I fit your role? Paste the posting and see the&nbsp;evidence.</h2>
        <p class="lede">
          I built job-radar to read postings for my own job search. Here it reads yours: a verdict and its reasons, each
          backed by a quote from the posting, checked word for word. It says no as plainly as yes.
        </p>
      </div>
      <!-- A posting on the radar, its evidence marked -->
      <div class="art" aria-hidden="true" data-art>
        <svg viewBox="0 0 600 560">
          <g class="rings">
            <circle cx="430" cy="290" r="120"></circle>
            <circle cx="430" cy="290" r="200"></circle>
            <circle cx="430" cy="290" r="280"></circle>
          </g>
          <g class="sheet">
            <rect class="paper" x="150" y="96" width="260" height="344" rx="16"></rect>
            {
              LINES.map((l, i) => {
                const y = 136 + i * 26 + (l.title ? 0 : 8);
                return (
                  <>
                    {l.mark && <rect class="hl" style={`--i:${l.mark}`} x="178" y={y + 4} width={l.w + 8} height="7" rx="2" />}
                    <rect class:list={['ln', l.title && 'title']} x="182" y={y} width={l.w} height={l.title ? 12 : 8} rx={l.title ? 6 : 4} />
                  </>
                );
              })
            }
            <g class="tag">
              {[0, 1, 2].map((n) => <rect class:list={['bar', n < VERDICT_LEVEL.strong && 'on']} x={182 + n * 13} y={412 - n * 7} width="8" height={10 + n * 7} rx="2" />)}
            </g>
          </g>
        </svg>
      </div>
    </header>

    <div class="demo">
      <fieldset class="samples">
        <legend class="step">Try a sample posting</legend>
        <ul>
          {
            samples.map((s) => (
              <li>
                <label>
                  <input class="visually-hidden" type="radio" name="fit-sample" value={s.id} checked={s.id === START} />
                  <span class="name">{s.title}</span>
                  <span class="co">{s.company}</span>
                </label>
              </li>
            ))
          }
        </ul>
        <p class="note">Made-up postings, answered ahead of time by the real check.</p>
        <a class="jump" href="#fit-paste">Or paste your own ↓</a>
      </fieldset>

      <div class="out">
        <div class="results" data-results>
          {
            samples.map((s) => (
              <article class="result" data-for={s.id} data-announce={`${s.title}: ${VERDICT_COPY[s.result.verdict].label}`}>
                <Fragment set:html={resultHtml(s.result, { label: `${s.title}, ${s.company}` })} />
                <details class="posting">
                  <summary>Read the posting</summary>
                  <div class="ptext" set:html={s.posting} />
                </details>
              </article>
            ))
          }
          <article class="result" data-for="live" data-live-result></article>
        </div>
      </div>

      <form class="paste" id="fit-paste" data-paste data-path={FIT_CHECK_PATH} data-min={LIMITS.minChars} data-max={LIMITS.maxChars}>
        <label class="step" for="fit-text">Or paste a job posting or link</label>
        <textarea
          id="fit-text"
          name="text"
          rows="6"
          placeholder="The job description, or a job link from Greenhouse, Lever or Ashby."
          aria-describedby="fit-need fit-privacy fit-count"
          data-text></textarea>
        <div class="row">
          <button type="submit" disabled data-go>Check the fit</button>
          <p class="meta">
            <span id="fit-privacy">Not stored or logged.</span>
            <span class="count" id="fit-count" data-count>0 / {LIMITS.maxChars.toLocaleString('en-GB')}</span>
          </p>
        </div>
        <p class="need" id="fit-need" data-need hidden></p>
        <noscript><p class="need">Checking your own posting needs JavaScript. The samples work without it.</p></noscript>
      </form>
    </div>

    <div class="close">
      <p>
        Claude Haiku reads the posting against my <a href="https://github.com/steveu/urm.st/blob/master/src/fit/profile.md">scoring profile</a>{' '}
        and picks from fixed reasons; it never writes words for this page. <Fragment set:html={EVAL_FIGURES.closeHtml} />
      </p>
      <a class="primary" href="/work/fit-check">How this was measured →</a>
    </div>
  </div>
  <p class="visually-hidden" role="status" data-status></p>
</section>

<script>
  import { VERDICT_COPY } from '../../fit/copy';
  import { BOARD_NAMES, parseJobLink, type ParsedLink } from '../../fit/links';
  import { validateAssessment } from '../../fit/schema';
  import {
    boardPostingHtml,
    ERROR_COPY,
    errorHtml,
    linkSteps,
    progressHtml,
    resultHtml,
    unassessableHtml,
    WAIT_HEADINGS,
    type ErrorCause,
  } from './result';

  const root = document.querySelector<HTMLElement>('[data-fit]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-paste]')!;
    const box = root.querySelector<HTMLTextAreaElement>('[data-text]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const need = root.querySelector<HTMLElement>('[data-need]')!;
    const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
    const live = root.querySelector<HTMLElement>('[data-live-result]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const art = root.querySelector<HTMLElement>('[data-art]')!;
    const min = Number(form.dataset.min);
    const max = Number(form.dataset.max);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LABEL = 'Your posting';
    const n = (x: number) => x.toLocaleString('en-GB');
    const GO = go.textContent;
    let running = false;
    // The text whose answer is in the live result, showing or behind a sample: checking it
    // again would cost a call for the same answer, so the button brings that answer back
    let answered: string | null = null;
    let answeredSay = '';
    const band = root;
    const liveShown = () => 'live' in band.dataset;

    // Exactly what the function checks the quotes against: line endings evened out, ends trimmed
    const prepared = () => box.value.replace(/\r\n?/g, '\n').trim();

    // A link is read from its board, so the length rules are the board's text's, not the paste's
    const linkIn = (): ParsedLink | null => parseJobLink(prepared());
    const ready = (link: ParsedLink | null, len: number) => (link ? link.kind === 'board' : len >= min && len <= max);

    function counter() {
      const len = prepared().length;
      const link = linkIn();
      count.textContent = link?.kind === 'board' ? `${BOARD_NAMES[link.board]} link` : `${n(len)} / ${n(max)}`;
      count.classList.toggle('over', !link && len > max);
      const msg =
        link?.kind === 'linkedin'
          ? ERROR_COPY.linkedin
          : link?.kind === 'other'
            ? ERROR_COPY.other_link
            : link
              ? ''
              : len > max
                ? `${n(len - max)} characters over. Trim it to the job description itself.`
                : len > 0 && len < min
                  ? 'That looks short for a job posting. Paste the whole description.'
                  : '';
      need.textContent = msg;
      need.hidden = !msg;
      // With scripts on, the button stays focusable throughout: it's marked rather than disabled.
      // An outline while there's nothing new to check; filled once there is; dimmed while it runs
      go.disabled = false;
      const showing = prepared() === answered && liveShown();
      go.setAttribute('aria-disabled', String(running || !ready(link, len) || showing));
      go.setAttribute('aria-busy', String(running));
      go.textContent = running ? 'Checking…' : GO;
    }
    box.addEventListener('input', counter);
    counter();

    // Picking a sample: CSS shows it; this leaves any pasted result and says what changed
    root.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'fit-sample') return;
      delete root.dataset.live;
      counter();
      root.querySelectorAll<HTMLDetailsElement>('.posting[open]').forEach((d) => (d.open = false));
      const picked = root.querySelector<HTMLElement>(`[data-for="${input.value}"]`);
      status.textContent = picked?.dataset.announce ?? '';
      if (picked) play(picked);
    });

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // A result that has just been chosen or has just come back settles in, verdict first
    function play(el: HTMLElement) {
      if (reduce) return;
      el.classList.remove('play');
      void el.offsetWidth;
      el.classList.add('play');
    }

    // On a phone the result sits above the box; bring it into view if it's off screen
    function reveal() {
      const r = live.getBoundingClientRect();
      if (r.top < 0 || r.top > innerHeight * 0.6) live.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    }

    function show(html: string, say: string) {
      live.innerHTML = html;
      status.textContent = say;
    }

    const CAUSES: Record<string, ErrorCause> = {
      empty: 'too_short',
      too_short: 'too_short',
      too_long: 'too_long',
      busy: 'busy',
      linkedin: 'linkedin',
      unsupported_link: 'other_link',
      not_found: 'link_not_found',
      board_failed: 'link_failed',
    };
    // The same errors, said about a linked job's listing rather than the paste
    const LINK_CAUSES: Record<string, ErrorCause> = { empty: 'link_too_short', too_short: 'link_too_short' };

    interface LinkedPosting {
      board: keyof typeof BOARD_NAMES;
      title: string | null;
      text: string;
      truncated: boolean;
    }
    const isLinkedPosting = (p: unknown): p is LinkedPosting => {
      const o = p as LinkedPosting | null;
      return !!o && typeof o.text === 'string' && o.board in BOARD_NAMES && typeof o.truncated === 'boolean';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = prepared();
      const link = linkIn();
      if (running || !ready(link, text.length) || (text === answered && liveShown())) return;
      root.querySelectorAll<HTMLInputElement>('input[name="fit-sample"]').forEach((r) => (r.checked = false));
      root.dataset.live = '';
      // Back from a sample to a paste already answered: show that answer again, no new call
      if (text === answered) {
        counter();
        status.textContent = answeredSay;
        play(live);
        reveal();
        return;
      }
      // The live result is about to hold this check, not the last answer
      answered = null;
      running = true;
      counter();

      const boardName = link?.kind === 'board' ? BOARD_NAMES[link.board] : null;
      let label = boardName ? `Your ${boardName} link` : LABEL;
      const steps = boardName ? linkSteps(boardName) : undefined;
      const started = Date.now();
      show(progressHtml(label, 0, 0, steps), 'Checking your posting');
      play(live);
      reveal();
      const tick = setInterval(() => {
        const secs = live.querySelector('.secs');
        if (secs) secs.textContent = `${Math.round((Date.now() - started) / 1000)}s`;
      }, 1000);

      try {
        const res = await fetch(form.dataset.path!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        clearInterval(tick);
        const body = await res.json().catch(() => null);
        // For a link, the text the quotes come from is the board's, sent back with the answer
        const linked = boardName && isLinkedPosting(body?.posting) ? body.posting : null;
        if (linked?.title) label = `${linked.title}, from ${boardName}`;
        const source = linked ? linked.text : text;
        const postingView = (quotes: string[]) =>
          linked ? boardPostingHtml(linked.text, quotes, boardName!, linked.truncated) : '';

        if (res.status === 429) {
          show(errorHtml(label, 'rate_limited'), 'Too many checks in a row');
        } else if (body?.status === 'ok' && (!boardName || linked)) {
          // The function checked every quote; check them again here, against exactly what the
          // model read, before any of it is shown
          // The second step lights in place, so the list doesn't redraw
          const [first, second] = live.querySelectorAll<HTMLElement>('.progress li');
          if (first && second) {
            first.dataset.state = 'done';
            first.querySelector('.secs')?.remove();
            second.dataset.state = 'active';
            const heading = live.querySelector('.verdict h3');
            if (heading) heading.textContent = WAIT_HEADINGS[1];
          } else live.innerHTML = progressHtml(label, 1, 0, steps);
          const { status: _s, promptVersion: _p, posting: _t, ...answer } = body;
          const checked = validateAssessment(answer, source);
          await wait(reduce ? 0 : 400);
          if (checked.ok) {
            const a = checked.value;
            const quotes = [...a.reasons.map((r) => r.quote), a.location.quote, a.injection.quote].filter((q): q is string => !!q);
            show(resultHtml(a, { label, contact: true }) + postingView(quotes), VERDICT_COPY[a.verdict].label);
          } else show(unassessableHtml(label) + postingView([]), 'Couldn’t assess this one');
          answered = text;
          answeredSay = status.textContent ?? '';
        } else if (body?.status === 'unassessable') {
          show(unassessableHtml(label) + postingView([]), 'Couldn’t assess this one');
          answered = text;
          answeredSay = status.textContent ?? '';
        } else {
          const cause = (boardName && LINK_CAUSES[body?.error]) || CAUSES[body?.error] || 'unavailable';
          show(errorHtml(label, cause), 'The check didn’t run');
        }
      } catch {
        clearInterval(tick);
        show(errorHtml(label, 'network'), 'The check didn’t run');
      } finally {
        running = false;
        counter();
      }
    });

    // A posting longer than its reader fades out at the foot, so it's plain there's more
    root.addEventListener(
      'toggle',
      (e) => {
        const d = e.target as HTMLElement;
        const text = d.matches?.('.posting[open]') ? d.querySelector<HTMLElement>('.ptext') : null;
        if (text) text.classList.toggle('more', text.scrollHeight > text.clientHeight + 1);
      },
      true,
    );

    // The first time the band is seen, the sheet settles and its evidence is marked, line by
    // line. Scripts off or reduced motion: it's just there.
    if (!reduce) {
      art.classList.add('ready');
      new IntersectionObserver(
        (entries, io) => {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          art.classList.add('in');
        },
        { threshold: 0.5 },
      ).observe(art);
    }
  }
</script>

<style>
  .band {
    --ink: #efeff8;
    --soft: #c6c8e0;
    --faint: #9a9dc0;
    --mark: var(--job-radar-light);
    --hair: rgb(239 239 248 / 0.14);
    --hl: rgb(185 189 244 / 0.24);
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 5vw, 64px) 0 56px;
    background: var(--job-radar-deep);
    color: var(--ink);
  }

  .band :focus-visible {
    outline-color: var(--mark);
  }

  .band :global(a) {
    color: var(--mark);
    text-underline-offset: 3px;
  }

  .band :global(a:hover) {
    color: var(--ink);
  }

  /* ---- The head: eyebrow, title and lede, with the art beside, as in Eddy's band ---- */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--mark);
  }

  h2 {
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--soft);
    text-wrap: pretty;
  }

  .art {
    width: 100%;
    max-width: 440px;
    justify-self: end;
  }

  .art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rings circle {
    fill: none;
    stroke: var(--mark);
    stroke-width: 1.5;
  }
  .rings circle:nth-child(1) { opacity: 0.32; }
  .rings circle:nth-child(2) { opacity: 0.2; }
  .rings circle:nth-child(3) { opacity: 0.1; }

  /* The sheet is tonal, in the band's own colours, so the title stays the brightest thing */
  .sheet {
    transform: rotate(-3deg);
    transform-origin: 280px 268px;
    filter: drop-shadow(0 16px 32px rgb(0 0 0 / 0.25));
  }

  .paper { fill: #2a2d4a; stroke: var(--hair); stroke-width: 1.5; }
  .ln { fill: var(--soft); opacity: 0.22; }
  .ln.title { opacity: 0.5; }
  /* Marked as the posting's text is: a low band under the line */
  .hl { fill: var(--mark); opacity: 0.5; transform-box: fill-box; transform-origin: left center; }
  .bar { fill: var(--soft); opacity: 0.22; }
  .bar.on { fill: var(--mark); opacity: 0.85; }

  /* The way in: the rings come up, the sheet settles onto them under its own weight, then its
     evidence is marked in reading order and the verdict lands */
  .art.ready:not(.in) .rings { opacity: 0; }
  .art.ready:not(.in) .sheet { opacity: 0; transform: translateY(12px) rotate(-1deg); }
  .art.ready:not(.in) .hl { transform: scaleX(0); }
  .art.ready:not(.in) .tag { opacity: 0; transform: translateY(6px); }

  .art.in .rings { transition: opacity var(--fig-slow) var(--ease-out); }
  .art.in .sheet {
    transition:
      transform var(--fig-base) var(--fig-settle),
      opacity calc(var(--fig-base) * 0.6) var(--ease-out);
  }
  .art.in .hl { transition: transform var(--fig-fast) var(--fig-settle) calc(360ms + var(--i) * 140ms); }
  .tag { transform-box: fill-box; }
  .art.in .tag {
    transition:
      transform var(--fig-fast) var(--fig-spring) 900ms,
      opacity calc(var(--fig-fast) * 0.6) var(--ease-out) 900ms;
  }

  /* ---- The demo: samples and the box on the left, the result on the right ---- */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-areas:
      'samples out'
      'paste out';
    grid-template-rows: auto 1fr;
    column-gap: clamp(32px, 4vw, 56px);
    row-gap: 40px;
    margin-top: 40px;
  }

  .samples { grid-area: samples; }
  .out { grid-area: out; }
  .paste { grid-area: paste; }

  .step {
    padding: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--mark);
  }

  .samples {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .samples ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 14px -12px 0;
    padding: 0;
    list-style: none;
  }

  .samples label {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 9px 12px;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.16s var(--ease-out);
  }

  .samples label:hover {
    background: rgb(239 239 248 / 0.05);
  }

  .samples label:has(:checked) {
    background: rgb(239 239 248 / 0.1);
  }

  .samples label:has(:focus-visible) {
    outline: 2px solid var(--mark);
    outline-offset: 0;
  }

  .name {
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--soft);
  }

  label:has(:checked) .name {
    color: var(--ink);
  }

  .co {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--faint);
  }

  .note {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--faint);
  }

  /* On a phone the box is a long way down, under the samples and a whole result */
  .jump {
    display: none;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  /* ---- The result: all of them stacked in one cell, so the column holds the tallest ---- */
  .out {
    min-width: 0;
    padding-left: clamp(32px, 4vw, 56px);
    border-left: 1px solid var(--hair);
  }

  .results {
    display: grid;
  }

  .result {
    grid-area: 1 / 1;
    min-width: 0;
    visibility: hidden;
  }

  .band:has(input[value='strong']:checked) [data-for='strong'],
  .band:has(input[value='possible']:checked) [data-for='possible'],
  .band:has(input[value='poor']:checked) [data-for='poor'],
  .band:has(input[value='injection']:checked) [data-for='injection'],
  .band[data-live] [data-for='live'] {
    visibility: visible;
  }

  .result :global(.whose) {
    font-size: 13px;
    color: var(--faint);
  }

  .result :global(.verdict) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .result :global(.verdict h3) {
    font-size: clamp(32px, 3.4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* Three bars rising to the verdict, like a signal: one colour, no traffic light */
  .result :global(.meter) {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 26px;
  }

  .result :global(.meter i) {
    width: 7px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1.5px rgb(185 189 244 / 0.4);
  }

  .result :global(.meter i:nth-child(1)) { height: 10px; }
  .result :global(.meter i:nth-child(2)) { height: 18px; }
  .result :global(.meter i:nth-child(3)) { height: 26px; }

  .result :global(.meter i.on) {
    background: var(--mark);
    box-shadow: none;
  }

  .result :global(.line) {

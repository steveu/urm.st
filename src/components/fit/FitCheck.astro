---
// Home band for job-radar's fit check, a demo on my own profile: a posting is set on a sheet,
// each passage the answer rests on tinted in place in the colour of the side it pulls (sage
// for, clay against, straw mixed), with the verdict and a note level with each passage in the
// margin. Four made-up samples, answered ahead of time by the real check and committed
// (src/fit/sample-results.json), are picked from thumbnails: radio buttons, so they switch
// instantly and with scripts off, and CSS shows the checked sheet. "Paste your own" turns the
// sheet into the paste area. Every word on a sheet is site copy or the posting's own text, and
// one renderer (./result.ts) draws the samples here and a live answer in the browser.
//
// Motion, only when it's wanted: as a sheet is shown, its tints sweep in one after another,
// then each note's leader draws and the note fades in; the verdict arrives last.
import '@fontsource-variable/petrona/wght.css';
import { LIMITS } from '../../fit/check';
import { VERDICT_COPY } from '../../fit/copy';
import { FIT_CHECK_PATH } from '../../fit/handler';
import { BOARD_LIST } from '../../fit/links';
import { SAMPLE_POSTINGS, type SamplePosting } from '../../fit/samples';
import { SAMPLE_RESULTS } from '../../fit/sample-results';
import { EVAL_FIGURES } from '../../fit/evals/figures';
import { miniHtml, PIN, resultSheetHtml } from './result';

const START: SamplePosting['id'] = 'strong';
const PROFILE = 'https://github.com/steveu/urm.st/blob/master/src/fit/profile.md';

// Short names under the thumbnails; the full title is on the sheet
const SHORT: Record<SamplePosting['id'], string> = {
  strong: 'AI product engineer',
  possible: 'Lead frontend',
  poor: 'Backend engineer',
  injection: 'Product designer',
};

const samples = SAMPLE_POSTINGS.map((s) => {
  const result = SAMPLE_RESULTS.results[s.id];
  if (!result) throw new Error(`No committed result for the ${s.id} sample: run scripts/fit-samples.ts`);
  const label = `${s.title}, ${s.company}`;
  return {
    id: s.id,
    label,
    short: SHORT[s.id],
    announce: `${s.title}: ${VERDICT_COPY[result.verdict].label}`,
    sheet: resultSheetHtml(s.text, result, { label }),
    mini: miniHtml(s.text, result),
  };
});
---

<section id="fit-check" class="band fit" aria-labelledby="fit-check-title" data-fit>
  <div class="wrap grid">
    <header class="head">
      <p class="kicker"><span>job-radar</span></p>
      <h2 id="fit-check-title">Every reason, in the posting’s own&nbsp;words.</h2>
      <p class="lede">
        job-radar is a matching tool I’m building. This demo runs on <a href={PROFILE}>my own profile</a>, the one I can
        judge it against honestly. It can only choose from a fixed list of reasons, and each one has to quote the posting
        word for word, or it isn’t shown. Paste a posting and see.
      </p>
    </header>

    <div class="stage">
      <fieldset class="thumbs">
        <legend class="visually-hidden">Choose a posting</legend>
        <label class="thumb own">
          <input class="visually-hidden" type="radio" name="fit-posting" value="own" />
          <span class="mini blank" aria-hidden="true" data-own-mini>
            <svg class="plus" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg>
          </span>
          <span class="cap" data-own-cap>Paste your own</span>
        </label>
        {
          samples.map((s) => (
            <label class="thumb" title={s.label}>
              <input class="visually-hidden" type="radio" name="fit-posting" value={s.id} checked={s.id === START} />
              <span class="mini" aria-hidden="true" set:html={s.mini} />
              <span class="cap">{s.short}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="sheets" data-sheets>
        {samples.map((s) => <div class="sheet" data-for={s.id} data-announce={s.announce} set:html={s.sheet} />)}
        <div class="sheet own" data-for="own">
          <form
            class="page paste"
            id="fit-paste"
            data-paste
            data-path={FIT_CHECK_PATH}
            data-min={LIMITS.minChars}
            data-max={LIMITS.maxChars}>
            <div class="t paste-area">
              <label class="ask" for="fit-text">Your posting</label>
              <textarea
                id="fit-text"
                name="text"
                placeholder={`Paste the text of a job posting, or a ${BOARD_LIST.replace(' and ', ' or ')} job link.`}
                aria-describedby="fit-need fit-privacy fit-count"
                data-text></textarea>
              <div class="paste-bar">
                <button type="submit" disabled data-go>Check the fit</button>
                <p class="small" id="fit-privacy">Not stored or logged.</p>
                <p class="small count" id="fit-count" data-count>0 / {LIMITS.maxChars.toLocaleString('en-GB')}</p>
              </div>
              <p class="need" id="fit-need" data-need hidden></p>
              <noscript><p class="need">Checking your own posting needs JavaScript. The samples work without it.</p></noscript>
            </div>
            <div class="m key">
              <p class="key-head">What comes back</p>
              <p class="chip ghost">
                <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5.25"></circle></svg>
                A verdict
              </p>
              <p class="key-line">A strong, partial or poor match, with a line on why.</p>
              <ul class="legend">
                <li data-tone="for"><span class="swatch"></span><b>For</b> lines up with the profile</li>
                <li data-tone="against"><span class="swatch"></span><b>Against</b> pulls away from it</li>
                <li data-tone="mixed"><span class="swatch"></span><b>Mixed</b> a bit of both</li>
                <li data-tone="neutral" class="where"><span class="swatch"><Fragment set:html={PIN} /></span><b>Location</b> against the profile’s preferences</li>
                <li data-tone="void"><span class="swatch"></span><b>Ignored</b> instructions aimed at AI tools</li>
              </ul>
              <p class="key-line">Every mark is the posting’s own words, checked against your text.</p>
            </div>
          </form>
          <div class="live" data-live tabindex="-1"></div>
        </div>
      </div>
    </div>

    <footer class="close">
      <p>
        Claude Haiku picks the verdict and the reasons and quotes the posting; it never writes a word that appears
        here.{' '}<Fragment set:html={EVAL_FIGURES.closeHtml} />
      </p>
      <a class="more" href="/work/fit-check">How this was measured →</a>
    </footer>
  </div>
  <p class="visually-hidden" role="status" data-status></p>
</section>

<script>
  import { VERDICT_COPY } from '../../fit/copy';
  import { BOARD_NAMES, parseJobLink, type ParsedLink } from '../../fit/links';
  import { validateAssessment } from '../../fit/schema';
  import {
    ERROR_COPY,
    errorSheetHtml,
    linkSteps,
    miniHtml,
    progressSheetHtml,
    resultSheetHtml,
    unassessableSheetHtml,
    WAIT_HEADINGS,
    type ErrorCause,
    type SheetOptions,
  } from './result';

  const root = document.querySelector<HTMLElement>('[data-fit]');
  if (root) {
    const band = root;
    const form = band.querySelector<HTMLFormElement>('[data-paste]')!;
    const box = band.querySelector<HTMLTextAreaElement>('[data-text]')!;
    const count = band.querySelector<HTMLElement>('[data-count]')!;
    const need = band.querySelector<HTMLElement>('[data-need]')!;
    const go = band.querySelector<HTMLButtonElement>('[data-go]')!;
    const live = band.querySelector<HTMLElement>('[data-live]')!;
    const status = band.querySelector<HTMLElement>('[data-status]')!;
    const sheets = band.querySelector<HTMLElement>('[data-sheets]')!;
    const ownMini = band.querySelector<HTMLElement>('[data-own-mini]')!;
    const ownCap = band.querySelector<HTMLElement>('[data-own-cap]')!;
    const ownRadio = band.querySelector<HTMLInputElement>('input[name="fit-posting"][value="own"]')!;
    const PLUS = ownMini.innerHTML;
    const min = Number(form.dataset.min);
    const max = Number(form.dataset.max);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = (x: number) => x.toLocaleString('en-GB');
    const GO = go.textContent;
    let running = false;
    // The text whose answer is in the live sheet: checking it again would cost a call for the
    // same answer, so the button brings that answer back instead
    let answered: string | null = null;
    let answeredSay = '';
    let answeredMini = '';

    // Exactly what the function checks the quotes against: line endings evened out, ends trimmed
    const prepared = () => box.value.replace(/\r\n?/g, '\n').trim();

    // A link is read from its board, so the length rules are the board's text's, not the paste's
    const linkIn = (): ParsedLink | null => parseJobLink(prepared());
    const ready = (link: ParsedLink | null, len: number) => (link ? link.kind === 'board' : len >= min && len <= max);
    const showingOwn = () => band.dataset.own === 'result';

    function counter() {
      const len = prepared().length;
      const link = linkIn();
      count.textContent = link?.kind === 'board' ? `${BOARD_NAMES[link.board]} link` : `${n(len)} / ${n(max)}`;
      count.classList.toggle('over', !link && len > max);
      const msg =
        link?.kind === 'linkedin'
          ? ERROR_COPY.linkedin
          : link?.kind === 'other'
            ? ERROR_COPY.other_link
            : link
              ? ''
              : len > max
                ? `${n(len - max)} characters over. Trim it to the job description itself.`
                : len > 0 && len < min
                  ? 'That looks short for a job posting. Paste the whole description.'
                  : '';
      need.textContent = msg;
      need.hidden = !msg;
      // With scripts on, the button stays focusable throughout: it's marked rather than disabled,
      // filled once there's something to check and dimmed while a check runs
      go.disabled = false;
      go.setAttribute('aria-disabled', String(running || !ready(link, len)));
      go.setAttribute('aria-busy', String(running));
      go.textContent = running ? 'Checking…' : GO;
    }

    // The paste thumbnail follows the text: grey lines as it's typed, its marks once answered
    function ownThumb() {
      const text = prepared();
      const own = answered !== null && text === answered ? answeredMini : text && !linkIn() ? miniHtml(text) : '';
      ownMini.classList.toggle('blank', !own);
      ownMini.innerHTML = own || PLUS;
      ownCap.textContent = own || answered !== null ? 'Your posting' : 'Paste your own';
    }
    let thumbQueued = false;
    box.addEventListener('input', () => {
      counter();
      if (thumbQueued) return;
      thumbQueued = true;
      requestAnimationFrame(() => {
        thumbQueued = false;
        ownThumb();
      });
    });
    counter();

    const pageIn = (el: Element | null) => el?.querySelector<HTMLElement>('.page[data-state="result"]') ?? null;
    const sheetFor = (id: string) => sheets.querySelector<HTMLElement>(`.sheet[data-for="${id}"]`);

    // A sheet that has just been chosen or has just come back is drawn in: its tints in reading
    // order, then the notes, the verdict last. Reduced motion: it's just there
    function play(page: HTMLElement | null) {
      if (reduce || !page) return;
      page.classList.remove('play', 'held');
      void page.offsetWidth;
      page.classList.add('play');
    }

    // Picking a posting: CSS shows its sheet; this says what changed and draws it in
    band.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'fit-posting') return;
      if (input.value === 'own') {
        status.textContent = showingOwn() ? answeredSay : 'Paste a job posting or link to check it';
        if (showingOwn()) play(pageIn(live));
        return;
      }
      const sheet = sheetFor(input.value);
      status.textContent = sheet?.dataset.announce ?? '';
      play(pageIn(sheet));
    });

    // Choosing "Paste your own" with a pointer goes straight to the text; arrow keys stay in the row
    ownRadio.closest('label')!.addEventListener('click', (e) => {
      if (e.detail > 0 && !showingOwn()) requestAnimationFrame(() => box.focus({ preventScroll: true }));
    });

    // Back from an answer to the paste area, the text kept
    live.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-edit]')) return;
      delete band.dataset.own;
      counter();
      status.textContent = 'Paste area';
      box.focus();
    });

    // On a phone the sheet may be off screen; bring its top into view
    function reveal() {
      const r = live.getBoundingClientRect();
      if (r.top < 0 || r.top > innerHeight * 0.6) live.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    }

    function show(html: string, say: string) {
      live.innerHTML = html;
      status.textContent = say;
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const CAUSES: Record<string, ErrorCause> = {
      empty: 'too_short',
      too_short: 'too_short',
      too_long: 'too_long',
      busy: 'busy',
      linkedin: 'linkedin',
      unsupported_link: 'other_link',
      not_found: 'link_not_found',
      board_failed: 'link_failed',
    };
    // The same errors, said about a linked job's listing rather than the paste
    const LINK_CAUSES: Record<string, ErrorCause> = { empty: 'link_too_short', too_short: 'link_too_short' };

    interface LinkedPosting {
      board: keyof typeof BOARD_NAMES;
      title: string | null;
      text: string;
      truncated: boolean;
    }
    const isLinkedPosting = (p: unknown): p is LinkedPosting => {
      const o = p as LinkedPosting | null;
      return !!o && typeof o.text === 'string' && o.board in BOARD_NAMES && typeof o.truncated === 'boolean';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = prepared();
      const link = linkIn();
      if (running || !ready(link, text.length)) return;
      ownRadio.checked = true;
      band.dataset.own = 'result';
      live.focus({ preventScroll: true });
      // Back to a paste already answered: show that answer again, no new call
      if (text === answered) {
        counter();
        status.textContent = answeredSay;
        play(pageIn(live));
        reveal();
        return;
      }
      // The live sheet is about to hold this check, not the last answer
      answered = null;
      running = true;
      counter();
      ownThumb();

      const boardName = link?.kind === 'board' ? BOARD_NAMES[link.board] : null;
      let label = boardName ? `Your ${boardName} link` : 'Your posting';
      const steps = boardName ? linkSteps(boardName) : undefined;
      // A pasted posting stays on the sheet while it's read; a link has no text yet
      const pasted = boardName ? null : text;
      const opts = (): SheetOptions => ({ label, edit: true, ...(boardName ? { link: text } : {}) });
      const started = Date.now();
      show(progressSheetHtml(pasted, { ...opts(), step: 0, steps }), 'Checking your posting');
      reveal();
      const tick = setInterval(() => {
        const secs = live.querySelector('.secs');
        if (secs) secs.textContent = `${Math.round((Date.now() - started) / 1000)}s`;
      }, 1000);

      try {
        const res = await fetch(form.dataset.path!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        clearInterval(tick);
        const body = await res.json().catch(() => null);
        // For a link, the text the quotes come from is the board's, sent back with the answer
        const linked = boardName && isLinkedPosting(body?.posting) ? body.posting : null;
        if (linked?.title) label = `${linked.title}, from ${boardName}`;
        const source = linked ? linked.text : pasted;
        const from = linked ? { source: { board: boardName!, truncated: linked.truncated } } : {};

        if (res.status === 429) {
          show(errorSheetHtml(pasted, 'rate_limited', opts()), 'Too many checks in a row');
        } else if (body?.status === 'ok' && source !== null) {
          // The function checked every quote; check them again here, against exactly what the
          // model read, before any of it is shown. The second step lights in place
          const [first, second] = live.querySelectorAll<HTMLElement>('.steps li');
          if (first && second) {
            first.dataset.state = 'done';
            first.querySelector('.secs')?.remove();
            second.dataset.state = 'active';
            const chip = live.querySelector('[data-wait]');
            if (chip) chip.textContent = WAIT_HEADINGS[1];
          }
          const { status: _s, promptVersion: _p, posting: _t, ...answer } = body;
          const checked = validateAssessment(answer, source);
          await wait(reduce ? 0 : 400);
          if (checked.ok) {
            const a = checked.value;
            show(resultSheetHtml(source, a, { ...opts(), ...from }), `${label}: ${VERDICT_COPY[a.verdict].label}`);
            answeredMini = miniHtml(source, a);
            play(pageIn(live));
          } else {
            show(unassessableSheetHtml(source, { ...opts(), ...from }), 'Couldn’t assess this one');
            answeredMini = miniHtml(source);
          }
          answered = text;
          answeredSay = status.textContent ?? '';
        } else if (body?.status === 'unassessable') {
          show(unassessableSheetHtml(source, { ...opts(), ...from }), 'Couldn’t assess this one');
          answered = text;
          answeredSay = status.textContent ?? '';
          answeredMini = source ? miniHtml(source) : '';
        } else {
          const cause = (boardName && LINK_CAUSES[body?.error]) || CAUSES[body?.error] || 'unavailable';
          show(errorSheetHtml(pasted, cause, opts()), 'The check didn’t run');
        }
      } catch {
        clearInterval(tick);
        show(errorSheetHtml(pasted, 'network', opts()), 'The check didn’t run');
      } finally {
        running = false;
        counter();
        ownThumb();
      }
    });

    // The first time the band is seen, the shown sample is drawn in. It's held at its start,
    // marks unpainted, until then; scripts off or reduced motion, it's just there
    if (!reduce && 'IntersectionObserver' in window) {
      const first = pageIn(sheetFor(band.querySelector<HTMLInputElement>('input[name="fit-posting"]:checked')?.value ?? ''));
      if (first) {
        first.classList.add('play', 'held');
        new IntersectionObserver(
          (entries, io) => {
            if (!entries[0].isIntersecting) return;
            io.disconnect();
            first.classList.remove('held');
          },
          { threshold: 0.35 },
        ).observe(first);
      }
    }
  }
</script>

<style is:global>
  .fit {
    /* The band's palette: the posting on warm paper, near-black ink, and the three job-radar
       tints, each with a deeper marker and an ink for words set on it */
    --ink: var(--text);
    --ink-2: #47433d;
    --muted: #6b665e;
    --rule: #e8e4dc;
    --line: #dcd7cd;
    --paper: var(--job-radar-paper);
    --gap: 40px;
    --margin-w: 236px;
    --serif: 'Petrona Variable', Georgia, serif;

    padding-block: clamp(44px, 5vw, 64px) 56px;
    border-top: 1px solid #e9e3d6;
    background: var(--bg);
    color: var(--ink);
  }

  /* One tone, picked by data-tone, drives every coloured thing */
  .fit [data-tone='for'] {
    --c: var(--job-radar-sage);
    --c-tint: var(--job-radar-sage-tint);
    --c-ink: var(--job-radar-sage-ink);
  }
  .fit [data-tone='against'] {
    --c: var(--job-radar-clay);
    --c-tint: var(--job-radar-clay-tint);
    --c-ink: var(--job-radar-clay-ink);
  }
  .fit [data-tone='mixed'] {
    --c: var(--job-radar-straw);
    --c-tint: var(--job-radar-straw-tint);
    --c-ink: var(--job-radar-straw-ink);
  }
  .fit [data-tone='neutral'],
  .fit [data-tone='void'] {
    --c: var(--job-radar-stone);
    --c-tint: var(--job-radar-stone-tint);
    --c-ink: var(--job-radar-stone-ink);
  }

  .fit :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .fit .grid {
    display: grid;
    grid-template-columns: minmax(0, 284px) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head stage'
      'close stage';
    column-gap: 64px;
  }

  /* ---- Left column: the words about it ---- */
  .fit .head {
    grid-area: head;
    padding-top: 2px;
  }

  .fit .kicker {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--job-radar-sage-ink);
  }

  .fit .kicker span {
    margin-left: -6px;
    padding: 2px 6px;
    border-radius: 3px;
    background: var(--job-radar-sage-tint);
  }

  .fit h2 {
    margin-top: 14px;
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .fit .lede {
    margin-top: 18px;
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .fit .lede a,
  .fit .close a {
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
    text-underline-offset: 2px;
  }

  .fit .lede a:hover,
  .fit .close a:hover {
    color: var(--accent-hover);
  }

  .fit .close {
    grid-area: close;
    align-self: end;
    margin-top: 28px;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .fit .close strong {
    font-weight: 700;
    color: var(--ink);
  }

  .fit .close .more {
    display: inline-block;
    margin-top: 12px;
    border-bottom: 1px solid var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  /* ---- The stage: thumbnails and the sheet ---- */
  .fit .stage {
    grid-area: stage;
    min-width: 0;
  }

  .fit .thumbs {
    display: flex;
    gap: 18px;
    min-width: 0;
    margin: 0 0 18px;
    padding: 0;
    border: 0;
  }

  .fit .thumb {
    display: grid;
    justify-items: start;
    gap: 7px;
    cursor: pointer;
  }

  /* A posting in miniature, the same card as the sheet below: landscape, at its proportions */
  .fit .mini {
    display: block;
    width: 104px;
    aspect-ratio: 1.55;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(60 50 35 / 0.1),
      0 1px 2px rgb(60 50 35 / 0.06);
    transition:
      transform 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }

  .fit .mini .body {
    display: block;
    padding: 8px 10px 0;
  }

  /* Only the evidence is drawn; the rest of the posting is a faint trace */
  .fit .mini i {
    display: block;
    width: var(--w);
    height: 1px;
    margin: 2px 0 1px;
    border-radius: 1px;
    background: #ebe7e0;
  }

  .fit .mini i:first-child {
    margin-top: 0;
  }

  .fit .mini i[data-type='title'] {
    height: 3px;
    margin-bottom: 0;
    background: #8c867c;
  }

  .fit .mini i[data-gap] {
    margin-top: 4px;
  }

  .fit .mini i[data-tone] {
    height: 2px;
    margin-bottom: 0;
    background: var(--c);
  }

  .fit .mini i[data-tone='void'] {
    background: repeating-linear-gradient(90deg, var(--job-radar-stone) 0 2px, transparent 2px 3px);
  }

  .fit .cap {
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 600;
    white-space: nowrap;
    color: var(--muted);
  }

  .fit .thumb:hover .mini {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgb(60 50 35 / 0.16),
      0 4px 10px -4px rgb(60 50 35 / 0.25);
  }

  .fit .thumb:hover .cap,
  .fit .thumb input:checked ~ .cap {
    color: var(--ink);
  }


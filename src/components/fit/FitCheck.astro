---
// Home band for job-radar's fit check, a demo on my own profile. Beside the sheet, the pool:
// every role on a set of public job boards, narrowed by a title rule, a place rule and Jev,
// which rules out the clear noes (src/fit/finder). The funnel draws each step narrowing from
// the last. What's left is listed by company, never ranked. Opening a role sends its link to
// the fit check, and Haiku's answer is set on the sheet: each passage it rests on tinted in
// place in the colour of the side it pulls (sage for, clay against, straw mixed), with the
// verdict and a note level with each passage in the margin. A visitor can paste their own
// posting instead. Every word on a sheet is site copy or the posting's own text, and one
// renderer (./result.ts) draws them.
//
// Motion, only when it's wanted: the funnel narrows step by step; as a sheet is shown, its
// tints sweep in one after another, then each note's leader draws and the note fades in; the
// verdict arrives last.
import '@fontsource-variable/petrona/wght.css';
import './fit.css';
import { LIMITS } from '../../fit/check';
import { FIT_CHECK_PATH } from '../../fit/handler';
import { FINDER_BOARDS } from '../../fit/finder/boards';
import { FUNNEL_PATH } from '../../fit/finder/handler';
import { BOARD_LIST } from '../../fit/links';
import { EVAL_FIGURES } from '../../fit/evals/figures';
import { PIN } from './result';

const PROFILE = 'https://github.com/steveu/urm.st/blob/master/src/fit/profile.md';
const BOARDS = FINDER_BOARDS.length;
---

<section id="fit-check" class="band fit" aria-labelledby="fit-check-title" data-fit data-pane="role" data-boards={BOARDS}>
  <div class="wrap grid">
    <header class="head">
      <p class="kicker"><span>job-radar</span></p>
      <h2 id="fit-check-title">Every reason, in the posting’s own&nbsp;words.</h2>
      <p class="lede">
        job-radar is a matching tool I’m building. This demo runs on <a href={PROFILE}>my own profile</a>, the one I can
        judge it against honestly. It reads every role on {BOARDS} public job boards. Two plain rules keep the engineering,
        design and product roles open to the UK, and Jev, a fast decision model, rules out the clear noes. Open any role
        and Haiku checks it, choosing from a fixed list of reasons, each quoting the posting word for word.
      </p>
    </header>

    <div class="pool" data-pool data-path={FUNNEL_PATH}>
      <div class="funnel" data-funnel aria-live="polite">
        <ol class="funnel-bars ghosted" aria-hidden="true">
          {
            [100, 72, 44, 18].map((w, i) => (
              <li style={`--i:${i};--from:${w}%;--w:${w}%`}>
                <span class="track"><span class="bar" /></span>
                <span class="cap" />
              </li>
            ))
          }
        </ol>
        <p class="funnel-note" data-funnel-note>The live list needs JavaScript.</p>
      </div>
      <div class="pool-list" data-pool-list hidden>
        <div class="pool-tabs" role="group" aria-label="Which roles to list">
          <button type="button" aria-pressed="true" data-view="left">Left <span data-count-left></span></button>
          <button type="button" aria-pressed="false" data-view="out">Ruled out <span data-count-out></span></button>
        </div>
        <label class="visually-hidden" for="fit-filter">Filter by title or company</label>
        <input id="fit-filter" class="pool-filter" type="search" placeholder="Filter by title or company" autocomplete="off" data-filter />
        <div class="roles" data-roles tabindex="-1"></div>
      </div>
      <button type="button" class="own-btn" data-own aria-pressed="false">
        <svg class="plus" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10"></path></svg>
        Paste a posting or job link of your own
      </button>
    </div>

    <div class="stage">
      <div class="sheet" data-for="role">
        <div class="live-real" data-real tabindex="-1">
          <div class="page" data-state="message">
            <p class="t">Checking a live role needs JavaScript.</p>
          </div>
        </div>
      </div>
      <div class="sheet own" data-for="own">
        <form
          class="page paste"
          id="fit-paste"
          data-paste
          data-path={FIT_CHECK_PATH}
          data-min={LIMITS.minChars}
          data-max={LIMITS.maxChars}>
          <div class="t paste-area">
            <label class="ask" for="fit-text">Your posting</label>
            <textarea
              id="fit-text"
              name="text"
              placeholder={`Paste the text of a job posting, or a ${BOARD_LIST.replace(' and ', ' or ')} job link.`}
              aria-describedby="fit-need fit-privacy fit-count"
              data-text></textarea>
            <div class="paste-bar">
              <button type="submit" disabled data-go>Check the fit</button>
              <p class="small" id="fit-privacy">Not stored or logged.</p>
              <p class="small count" id="fit-count" data-count>0 / {LIMITS.maxChars.toLocaleString('en-GB')}</p>
            </div>
            <p class="need" id="fit-need" data-need hidden></p>
            <noscript><p class="need">Checking your own posting needs JavaScript.</p></noscript>
          </div>
          <div class="m key">
            <p class="key-head">What comes back</p>
            <p class="chip ghost">
              <svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5.25"></circle></svg>
              A verdict
            </p>
            <p class="key-line">A strong, partial or poor match, with a line on why.</p>
            <ul class="legend">
              <li data-tone="for"><span class="swatch"></span><b>For</b> lines up with the profile</li>
              <li data-tone="against"><span class="swatch"></span><b>Against</b> pulls away from it</li>
              <li data-tone="mixed"><span class="swatch"></span><b>Mixed</b> a bit of both</li>
              <li data-tone="neutral" class="where"><span class="swatch"><Fragment set:html={PIN} /></span><b>Location</b> against the profile’s preferences</li>
              <li data-tone="void"><span class="swatch"></span><b>Ignored</b> instructions aimed at AI tools</li>
            </ul>
            <p class="key-line">Every mark is the posting’s own words, checked against your text.</p>
          </div>
        </form>
        <div class="live" data-live tabindex="-1"></div>
      </div>
    </div>

    <footer class="close">
      <p>
        Jev only ever rules a role out. Claude Haiku picks the verdict and the reasons and quotes the posting; it never
        writes a word that appears here.{' '}<Fragment set:html={EVAL_FIGURES.closeHtml} />
      </p>
      <a class="more" href="/work/fit-check">How this was measured →</a>
    </footer>
  </div>
  <p class="visually-hidden" role="status" data-status></p>
</section>

<script>
  import { VERDICT_COPY } from '../../fit/copy';
  import { BOARD_NAMES, parseJobLink, type ParsedLink } from '../../fit/links';
  import { validateAssessment } from '../../fit/schema';
  import { funnelHtml, poolListHtml, readPool, type Pool, type PoolRole, type PoolView } from './pool';
  import {
    ERROR_COPY,
    errorSheetHtml,
    findingSheetHtml,
    linkSteps,
    progressSheetHtml,
    resultSheetHtml,
    unassessableSheetHtml,
    WAIT_HEADINGS,
    type ErrorCause,
    type SheetOptions,
  } from './result';

  const root = document.querySelector<HTMLElement>('[data-fit]');
  if (root) {
    const band = root;
    const form = band.querySelector<HTMLFormElement>('[data-paste]')!;
    const box = band.querySelector<HTMLTextAreaElement>('[data-text]')!;
    const count = band.querySelector<HTMLElement>('[data-count]')!;
    const need = band.querySelector<HTMLElement>('[data-need]')!;
    const go = band.querySelector<HTMLButtonElement>('[data-go]')!;
    const live = band.querySelector<HTMLElement>('[data-live]')!;
    const status = band.querySelector<HTMLElement>('[data-status]')!;
    const ownBtn = band.querySelector<HTMLButtonElement>('[data-own]')!;
    const min = Number(form.dataset.min);
    const max = Number(form.dataset.max);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = (x: number) => x.toLocaleString('en-GB');
    const GO = go.textContent;
    let running = false;
    // The text whose answer is in the live sheet: checking it again would cost a call for the
    // same answer, so the button brings that answer back instead
    let answered: string | null = null;
    let answeredSay = '';

    // Exactly what the function checks the quotes against: line endings evened out, ends trimmed
    const prepared = () => box.value.replace(/\r\n?/g, '\n').trim();

    // A link is read from its board, so the length rules are the board's text's, not the paste's
    const linkIn = (): ParsedLink | null => parseJobLink(prepared());
    const ready = (link: ParsedLink | null, len: number) => (link ? link.kind === 'board' : len >= min && len <= max);
    const showingOwn = () => band.dataset.own === 'result';

    function counter() {
      const len = prepared().length;
      const link = linkIn();
      count.textContent = link?.kind === 'board' ? `${BOARD_NAMES[link.board]} link` : `${n(len)} / ${n(max)}`;
      count.classList.toggle('over', !link && len > max);
      const msg =
        link?.kind === 'linkedin'
          ? ERROR_COPY.linkedin
          : link?.kind === 'other'
            ? ERROR_COPY.other_link
            : link
              ? ''
              : len > max
                ? `${n(len - max)} characters over. Trim it to the job description itself.`
                : len > 0 && len < min
                  ? 'That looks short for a job posting. Paste the whole description.'
                  : '';
      need.textContent = msg;
      need.hidden = !msg;
      // With scripts on, the button stays focusable throughout: it's marked rather than disabled,
      // filled once there's something to check and dimmed while a check runs
      go.disabled = false;
      go.setAttribute('aria-disabled', String(running || !ready(link, len)));
      go.setAttribute('aria-busy', String(running));
      go.textContent = running ? 'Checking…' : GO;
    }
    box.addEventListener('input', counter);
    counter();

    const pageIn = (el: Element | null) => el?.querySelector<HTMLElement>('.page[data-state="result"]') ?? null;

    // A sheet that has just been chosen or has just come back is drawn in: its tints in reading
    // order, then the notes, the verdict last. Reduced motion: it's just there
    function play(page: HTMLElement | null) {
      if (reduce || !page) return;
      page.classList.remove('play', 'held');
      void page.offsetWidth;
      page.classList.add('play');
    }

    // On a phone the sheet may be off screen; bring its top into view
    function reveal(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      if (r.top < 0 || r.top > innerHeight * 0.6) el.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    }

    // ---- Which pane the stage shows: a role from the pool, or the paste area ----
    function pane(which: 'role' | 'own') {
      band.dataset.pane = which;
      ownBtn.setAttribute('aria-pressed', String(which === 'own'));
      if (which === 'own') current = null;
      drawList();
    }

    ownBtn.addEventListener('click', (e) => {
      pane('own');
      status.textContent = showingOwn() ? answeredSay : 'Paste a job posting or link to check it';
      if (showingOwn()) play(pageIn(live));
      else if (e.detail > 0) requestAnimationFrame(() => box.focus({ preventScroll: true }));
      reveal(live.closest<HTMLElement>('.sheet')!);
    });

    // Back from an answer to the paste area, the text kept
    live.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-edit]')) return;
      delete band.dataset.own;
      counter();
      status.textContent = 'Paste area';
      box.focus();
    });

    function show(html: string, say: string) {
      live.innerHTML = html;
      status.textContent = say;
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const CAUSES: Record<string, ErrorCause> = {
      empty: 'too_short',
      too_short: 'too_short',
      too_long: 'too_long',
      busy: 'busy',
      linkedin: 'linkedin',
      unsupported_link: 'other_link',
      not_found: 'link_not_found',
      board_failed: 'link_failed',
    };
    // The same errors, said about a linked job's listing rather than the paste
    const LINK_CAUSES: Record<string, ErrorCause> = { empty: 'link_too_short', too_short: 'link_too_short' };

    interface LinkedPosting {
      board: keyof typeof BOARD_NAMES;
      title: string | null;
      text: string;
      truncated: boolean;
    }
    const isLinkedPosting = (p: unknown): p is LinkedPosting => {
      const o = p as LinkedPosting | null;
      return !!o && typeof o.text === 'string' && o.board in BOARD_NAMES && typeof o.truncated === 'boolean';
    };

    // The wait's first step done and the second lit, in place, while the quotes are checked
    function secondStep(sheet: HTMLElement) {
      const [first, second] = sheet.querySelectorAll<HTMLElement>('.steps li');
      if (!first || !second) return;
      first.dataset.state = 'done';
      first.querySelector('.secs')?.remove();
      second.dataset.state = 'active';
      const chip = sheet.querySelector('[data-wait]');
      if (chip) chip.textContent = WAIT_HEADINGS[1];
    }

    function ticker(sheet: HTMLElement) {
      const started = Date.now();
      return setInterval(() => {
        const secs = sheet.querySelector('.secs');
        if (secs) secs.textContent = `${Math.round((Date.now() - started) / 1000)}s`;
      }, 1000);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = prepared();
      const link = linkIn();
      if (running || !ready(link, text.length)) return;
      pane('own');
      band.dataset.own = 'result';
      live.focus({ preventScroll: true });
      // Back to a paste already answered: show that answer again, no new call
      if (text === answered) {
        counter();
        status.textContent = answeredSay;
        play(pageIn(live));
        reveal(live);
        return;
      }
      // The live sheet is about to hold this check, not the last answer
      answered = null;
      running = true;
      counter();

      const boardName = link?.kind === 'board' ? BOARD_NAMES[link.board] : null;
      let label = boardName ? `Your ${boardName} link` : 'Your posting';
      const steps = boardName ? linkSteps(boardName) : undefined;
      // A pasted posting stays on the sheet while it's read; a link has no text yet
      const pasted = boardName ? null : text;
      const opts = (): SheetOptions => ({ label, edit: true, ...(boardName ? { link: text } : {}) });
      show(progressSheetHtml(pasted, { ...opts(), step: 0, steps }), 'Checking your posting');
      reveal(live);
      const tick = ticker(live);

      try {
        const res = await fetch(form.dataset.path!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        clearInterval(tick);
        const body = await res.json().catch(() => null);
        // For a link, the text the quotes come from is the board's, sent back with the answer
        const linked = boardName && isLinkedPosting(body?.posting) ? body.posting : null;
        if (linked?.title) label = `${linked.title}, from ${boardName}`;
        const source = linked ? linked.text : pasted;
        const from = linked ? { source: { board: boardName!, truncated: linked.truncated } } : {};

        if (res.status === 429) {
          show(errorSheetHtml(pasted, 'rate_limited', opts()), 'Too many checks in a row');
        } else if (body?.status === 'ok' && source !== null) {
          // The function checked every quote; check them again here, against exactly what the
          // model read, before any of it is shown. The second step lights in place
          secondStep(live);
          const { status: _s, promptVersion: _p, posting: _t, ...answer } = body;
          const checked = validateAssessment(answer, source);
          await wait(reduce ? 0 : 400);
          if (checked.ok) {
            const a = checked.value;
            show(resultSheetHtml(source, a, { ...opts(), ...from }), `${label}: ${VERDICT_COPY[a.verdict].label}`);
            play(pageIn(live));
          } else {
            show(unassessableSheetHtml(source, { ...opts(), ...from }), 'Couldn’t assess this one');
          }
          answered = text;
          answeredSay = status.textContent ?? '';
        } else if (body?.status === 'unassessable') {
          show(unassessableSheetHtml(source, { ...opts(), ...from }), 'Couldn’t assess this one');
          answered = text;
          answeredSay = status.textContent ?? '';
        } else {
          const cause = (boardName && LINK_CAUSES[body?.error]) || CAUSES[body?.error] || 'unavailable';
          show(errorSheetHtml(pasted, cause, opts()), 'The check didn’t run');
        }
      } catch {
        clearInterval(tick);
        show(errorSheetHtml(pasted, 'network', opts()), 'The check didn’t run');
      } finally {
        running = false;
        counter();
      }
    });

    // ---- The pool: the funnel's counts, its roles, and a role opened on the sheet ----
    const poolEl = band.querySelector<HTMLElement>('[data-pool]')!;
    const funnelEl = band.querySelector<HTMLElement>('[data-funnel]')!;
    const listWrap = band.querySelector<HTMLElement>('[data-pool-list]')!;
    const rolesEl = band.querySelector<HTMLElement>('[data-roles]')!;
    const filterEl = band.querySelector<HTMLInputElement>('[data-filter]')!;
    const viewBtns = [...band.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const realBox = band.querySelector<HTMLElement>('[data-real]')!;
    const boards = Number(band.dataset.boards);

    let pool: Pool | null = null;
    let view: PoolView = 'left';
    let current: string | null = null;
    // Answers already had, by link, so opening a role again costs nothing
    const done = new Map<string, { html: string; say: string }>();
    const opened = new Set<string>();

    const rolesIn = (v: PoolView) => (pool ? (v === 'left' ? pool.left : pool.ruledOut) : []);

    function drawList() {
      if (!pool) return;
      rolesEl.innerHTML = poolListHtml(rolesIn(view), { filter: filterEl.value, current });
    }

    function setView(v: PoolView) {
      view = v;
      for (const b of viewBtns) b.setAttribute('aria-pressed', String(b.dataset.view === v));
      drawList();
      rolesEl.scrollTop = 0;
    }

    viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view as PoolView)));
    filterEl.addEventListener('input', drawList);

    rolesEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-link]');
      if (!btn) return;
      const role = rolesIn(view).find((r) => r.link === btn.dataset.link);
      if (role) void openRole(role, true);
    });

    // The open role's row, scrolled into view inside the list without moving the page
    function showCurrentRow() {
      const row = rolesEl.querySelector<HTMLElement>('[aria-current]');
      if (!row) return;
      const top = row.getBoundingClientRect().top - rolesEl.getBoundingClientRect().top + rolesEl.scrollTop;
      if (top < rolesEl.scrollTop || top > rolesEl.scrollTop + rolesEl.clientHeight - row.offsetHeight) rolesEl.scrollTop = top - 48;
    }

    // A role from what's left, not yet opened here, at random
    function randomRole(): PoolRole | null {
      const left = pool?.left ?? [];
      const fresh = left.filter((r) => !opened.has(r.link) && r.link !== current);
      const from = fresh.length ? fresh : left;
      return from.length ? from[Math.floor(Math.random() * from.length)] : null;
    }

    async function openRole(role: PoolRole, byHand: boolean) {
      pane('role');
      current = role.link;
      opened.add(role.link);
      drawList();
      if (!byHand) showCurrentRow();
      else reveal(realBox);
      const label = `${role.title}, ${role.company}`;
      const had = done.get(role.link);
      if (had) {
        realBox.innerHTML = had.html;
        status.textContent = had.say;
        play(pageIn(realBox));
        return;
      }
      const ruling = role.reason && typeof role.p === 'number' ? { reason: role.reason, p: role.p } : null;
      const found = { link: role.link, ruling, screened: !!pool?.screening };
      // Until the posting comes back with the answer: its title, and the company and places as listed
      const head = `${role.title}\n${[role.company, ...role.places].join(' · ')}`;
      realBox.innerHTML = progressSheetHtml(head, { label, step: 0, steps: linkSteps(role.board) });
      status.textContent = `Checking ${label}`;
      const tick = ticker(realBox);
      const isCurrent = () => current === role.link && band.dataset.pane === 'role';
      const put = (html: string, say: string, keep: boolean) => {
        if (keep) done.set(role.link, { html, say });
        if (!isCurrent()) return;
        realBox.innerHTML = html;
        status.textContent = say;
        play(pageIn(realBox));
      };

      try {
        const res = await fetch(form.dataset.path!, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text: role.link }),
        });
        clearInterval(tick);
        const body = await res.json().catch(() => null);
        const linked = isLinkedPosting(body?.posting) ? body.posting : null;
        const opts: SheetOptions = { label, found, ...(linked ? { source: { board: role.board, truncated: linked.truncated } } : {}) };
        if (res.status === 429) return put(errorSheetHtml(head, 'rate_limited', opts), 'Too many checks in a row', false);
        if (body?.status === 'ok' && linked) {
          if (isCurrent()) secondStep(realBox);
          const { status: _s, promptVersion: _p, posting: _t, ...answer } = body;
          const checked = validateAssessment(answer, linked.text);
          await wait(reduce ? 0 : 400);
          if (checked.ok) put(resultSheetHtml(linked.text, checked.value, opts), `${label}: ${VERDICT_COPY[checked.value.verdict].label}`, true);
          else put(unassessableSheetHtml(linked.text, opts), 'Couldn’t assess this one', true);
        } else if (body?.status === 'unassessable') {
          put(unassessableSheetHtml(linked?.text ?? head, opts), 'Couldn’t assess this one', true);
        } else {
          const cause = (LINK_CAUSES[body?.error] || CAUSES[body?.error] || 'unavailable') as ErrorCause;
          put(errorSheetHtml(head, cause, opts), 'The check didn’t run', false);
        }
      } catch {
        clearInterval(tick);
        put(errorSheetHtml(head, 'network', { label, found }), 'The check didn’t run', false);
      }
    }

    realBox.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-another]')) return;
      const role = randomRole();
      if (!role) return;
      if (view !== 'left' || filterEl.value) {
        filterEl.value = '';
        setView('left');
      }
      void openRole(role, false);
    });

    const FAILED = {
      boards: 'Couldn’t reach the job boards just now. Paste a posting or job link of your own instead.',
      none: 'No open roles on the boards just now. Paste a posting or job link of your own instead.',
      limited: 'That’s a lot of requests in a row. Try again in three minutes, or paste a posting of your own.',
    };

    function poolFailed(message: string) {
      funnelEl.querySelector('[data-funnel-note]')!.textContent = message;
      funnelEl.querySelector('.funnel-bars')?.remove();
      realBox.innerHTML = `<div class="page" data-state="message"><p class="plain">${message}</p></div>`;
      status.textContent = message;
    }

    async function loadPool() {
      realBox.innerHTML = findingSheetHtml(boards);
      funnelEl.querySelector('[data-funnel-note]')!.textContent = `Reading ${boards} job boards…`;
      status.textContent = 'Reading the job boards';
      try {
        const res = await fetch(poolEl.dataset.path!, { headers: { accept: 'application/json' } });
        const body = await res.json().catch(() => null);
        if (res.status === 429) return poolFailed(FAILED.limited);
        const p = body?.status === 'ok' ? readPool(body) : null;
        if (!p) return poolFailed(body?.error === 'none_found' ? FAILED.none : FAILED.boards);
        pool = p;
        // The funnel narrows step by step from the full width; reduced motion, it's just there
        funnelEl.innerHTML = funnelHtml(p);
        if (!reduce) {
          const bars = funnelEl.querySelector<HTMLElement>('.funnel-bars')!;
          void bars.offsetWidth;
          bars.classList.add('narrow');
        } else funnelEl.querySelector('.funnel-bars')!.classList.add('narrow', 'still');
        band.querySelector('[data-count-left]')!.textContent = n(p.left.length);
        band.querySelector('[data-count-out]')!.textContent = n(p.ruledOut.length);
        viewBtns.find((b) => b.dataset.view === 'out')!.hidden = !p.ruledOut.length;
        listWrap.hidden = false;
        drawList();
        // A role at random from what's left is open to begin with, unless the visitor has moved on
        const first = randomRole();
        if (first && band.dataset.pane === 'role' && !current) void openRole(first, false);
      } catch {
        poolFailed(FAILED.boards);
      }
    }

    // The pool is read as the band comes near, so a visitor who never scrolls to it costs nothing
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries, io) => {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          void loadPool();
        },
        { rootMargin: '0px 0px 50% 0px' },
      ).observe(band);
    } else void loadPool();
  }
</script>

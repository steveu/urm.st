    .result.play :global(.verdict h3) { --d: 1; }
    .result.play :global(.line), .result.play :global(.plain), .result.play :global(.progress) { --d: 2; }
    .result.play :global(.injection), .result.play :global(.hint) { --d: 3; }
    .result.play :global(.reasons .reason:nth-child(1)) { --d: 3; }
    .result.play :global(.reasons .reason:nth-child(2)) { --d: 4; }
    .result.play :global(.reasons .reason:nth-child(3)) { --d: 5; }
    .result.play :global(.injection ~ .reasons .reason:nth-child(1)) { --d: 4; }
    .result.play :global(.injection ~ .reasons .reason:nth-child(2)) { --d: 5; }
    .result.play :global(.injection ~ .reasons .reason:nth-child(3)) { --d: 6; }

  /* A result that has just been chosen or come back: the verdict lands, then its line and
     reasons follow in reading order. Rises are short and settle; fades run shorter */
  @media (prefers-reduced-motion: no-preference) {
    .result.play :global(:is(.whose, .verdict h3, .line, .injection, .reason, .contact, .posting, .plain, .progress, .hint)) {
      animation:

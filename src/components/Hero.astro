---
import ProjectList from './ProjectList.astro';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">
      <span class="then">I’ve designed, built and managed products since&nbsp;1999.</span>
      <span class="now">Now I build them with&nbsp;AI.</span>
    </h1>
    <p class="lede">
      UX, interface design, frontend engineering and product management, often all at once. Today I specify the
      product, design the experience, build the evals and review the code. The agents do the typing.
    </p>
  </div>

  <div class="list">
    <ProjectList />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: clamp(64px, 10vw, 112px) 0;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 980px;
  }

  h1 {
    font-weight: 500;
    font-size: clamp(42px, 6.4vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    text-wrap: balance;
  }

  .then {
    color: var(--faint);
  }

  .lede {
    max-width: 640px;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Entrance: one orchestrated reveal, nothing else moves */
  .intro > *,
  .list {
    animation: rise 0.7s var(--ease-out) both;
  }
  .intro > :nth-child(2) { animation-delay: 0.1s; }
  .list { animation-delay: 0.2s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
</style>

---
import ProjectList from './ProjectList.astro';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="intro">
    <h1 id="hero-title">
      <span>I build AI products,</span>
      <span class="after">from interface to&nbsp;evals.</span>
    </h1>
    <p class="lede">
      Agents, workflows and the context they run on, shaped by what someone needs rather than what the model can
      do. I’ve designed, built and managed products since&nbsp;2003.
    </p>
  </div>

  <div class="list">
    <ProjectList />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-block: clamp(48px, 7.5vw, 88px) 0;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 980px;
  }

  h1 {
    font-size: clamp(34px, 5.4vw, 72px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    text-wrap: balance;
  }

  .after {
    color: var(--faint);
  }

  .lede {
    max-width: 640px;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Entrance: one orchestrated reveal, nothing else moves */
  .intro > *,
  .list {
    animation: rise 0.7s var(--ease-out) both;
  }
  .intro > :nth-child(2) { animation-delay: 0.1s; }
  .list { animation-delay: 0.2s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
</style>
